        "id": "n32",
        "name": "Upright",
        "block": {
          "inline": {
            "source": "@block Upright begin\n    # Absolute angle of every link from the upright (+y) direction: a_k = q1 + ... + qk - pi/2.\n    @inputs begin\n        q1::Real\n        q2::Real\n        q3::Real\n    end\n    @outputs begin\n        a1::Real, [unit = \"rad\"]\n        a2::Real, [unit = \"rad\"]\n        a3::Real, [unit = \"rad\"]\n    end\n    @equations begin\n        a1 ~ q1 - 1.5707963267948966\n        a2 ~ q1 + q2 - 1.5707963267948966\n        a3 ~ q1 + q2 + q3 - 1.5707963267948966\n    end\nend\n"
          }
