<?xml version="1.0"?>
<!--
  inverted-pendulum-cart (plan 9.6c): a cart on a rail with a rod and a point mass at its tip.

  Z-up, metres, the pendulum swings in the X-Z plane. The rail is along X at z = -0.06; the cart
  hinge is the origin of the cart link. Joint "rail" (prismatic, +X) is bound to the cart position
  XInt/y; joint "hinge" (revolute, +Y) to the pendulum angle ThetaInt/y. theta is measured from
  upright and is positive towards +X (the model's tip is at x + l sin(theta), l cos(theta)), and a
  rotation about +Y takes +Z towards +X, so the axis is +Y. The rod is l = 0.5 m, the tip mass
  m = 0.2 kg, the cart M = 1 kg.
-->
<sdf version="1.9">
  <model name="inverted_pendulum_cart">
    <link name="rail_base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="rail">
        <pose>0 0 -0.1 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>1.6</length></cylinder></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
      <visual name="stop_left">
        <pose>-0.8 0 -0.07 0 0 0</pose>
        <geometry><box><size>0.04 0.12 0.12</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="stop_right">
        <pose>0.8 0 -0.07 0 0 0</pose>
        <geometry><box><size>0.04 0.12 0.12</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>

    <link name="cart">
      <pose>0 0 0 0 0 0</pose>
      <visual name="cart_body">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.2 0.12 0.08</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
    </link>

    <link name="pendulum">
      <pose>0 0 0 0 0 0</pose>
      <visual name="rod_bar">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="tip_mass">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="rail" type="prismatic">
      <parent>rail_base</parent>
      <child>cart</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>
    <joint name="hinge" type="revolute">
      <parent>cart</parent>
      <child>pendulum</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
