{
  "project": "industrial-servo",
  "description": "Plan 9.6b acceptance (X2.6). One PMSM servo drive in five fidelity variants. The plant is a bond graph (D28): d/q 1-junctions with R_s and L_d/L_q, an MGY cross-coupling w_e L, an MSe back-EMF -p psi_m w_m and a GY k_t = 1.5 p psi_m into the mechanical 1-junction; the measured i_q drives the GY through an MSf, which closes the dq 3/2 power convention. Rotor I(J_m)+R(B_m); the two-mass variants add an I-C-R flexible coupling through 0/1-junctions (parallel spring and damper). The firmware is three @discrete blocks (current 8 kHz, speed 1 kHz, position 200 Hz) with a one-sample delay; the switching variants add the PwmInverter (4 kHz carrier, 100 kHz comparator, 2 us dead time, 1.2 V device drop). The run is 1.2 s: a 100 rad/s speed step at 0.05 s, position mode at 0.15 s (the shaft returns from about 9.5 rad to 0), and a 2 N m load step at 0.9 s. Expected values are the measured values with margin; the README has the exact numbers.",
  "models": {
    "baseline": {
      "checks": [
        {
          "kind": "step_response",
          "signal": "WmSens/p.f",
          "from_t": 0.05,
          "to_t": 0.145,
          "value": 100.0,
          "initial": 0.0,
          "settle_abs": 2.0,
          "max_rise_time": 0.02,
          "max_overshoot": 0.06,
          "max_settling_time": 0.05,
          "note": "plan 9.6b speed loop: 100 rad/s step at 0.05 s; rise (10-90 %), overshoot and 2 rad/s settling for the 1 kHz PI"
        },
        {
          "kind": "step_response",
          "signal": "Theta/y",
          "from_t": 0.15,
          "to_t": 0.88,
          "value": 0.0,
          "settle_abs": 0.005,
          "max_rise_time": 0.15,
          "max_overshoot": 0.002,
          "max_settling_time": 0.8,
          "note": "position mode at 0.15 s: the shaft returns from about 9.4-9.7 rad to 0; the 5 mrad band is checked before the 0.9 s load step"
        },
        {
          "kind": "step_response",
          "signal": "Iq/p.f",
          "from_t": 0.05,
          "to_t": 0.053,
          "value": 15.0,
          "initial": 0.0,
          "settle_abs": 0.8,
          "max_rise_time": 0.002,
          "max_overshoot": 0.08,
          "max_settling_time": 0.004,
          "note": "plan 9.6b current loop: the 15 A command step at 0.05 s (the speed loop is saturated); 8 kHz PI with a 500 Hz crossover"
        },
        {
          "kind": "final_value",
          "signal": "Theta/y",
          "t": 1.15,
          "value": 0.0,
          "abs": 0.0015,
          "note": "steady position after the 2 N m load step at 0.9 s (the speed-loop integral rejects it)"
        },
        {
          "kind": "final_value",
          "signal": "WmSens/p.f",
          "t": 1.15,
          "value": 0.0,
          "abs": 0.2,
          "note": "steady speed after the load step"
        },
        {
          "kind": "final_value",
          "signal": "PosLoop/pos_err",
          "t": 1.15,
          "value": 0.0,
          "abs": 0.0015,
          "note": "position-loop error at the end of the run"
        },
        {
          "kind": "max_abs_le",
          "signal": "SpeedLoop/iq_cmd",
          "value": 15.0,
          "note": "the speed-loop output is clamped at the 15 A peak current limit (7.2 N m)"
        },
        {
          "kind": "max_abs_le",
          "signal": "Iq/p.f",
          "value": 16.0,
          "note": "the measured q current stays within 16 A (the 15 A reference plus the current-loop overshoot)"
        },
        {
          "kind": "max_abs_le",
          "signal": "GY/p2.e",
          "value": 7.7,
          "note": "plan 9.6b torque limit: k_t = 0.48 N m/A times the 16 A peak"
        },
        {
          "kind": "max_abs_le",
          "signal": "CurLoop/vmag",
          "value": 173.3,
          "note": "plan 9.6b averaged-inverter limit V_dc/sqrt(3) = 173.205 V"
        },
        {
          "kind": "ripple",
          "signal": "Iphase/y",
          "from_t": 1.0,
          "to_t": 1.15,
          "highpass_hz": 1000.0,
          "measure": "rms",
          "value": 0.01,
          "note": "phase-current high-frequency RMS in the steady window after the load step"
        },
        {
