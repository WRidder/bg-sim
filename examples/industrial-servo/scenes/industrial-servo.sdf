<?xml version="1.0"?>
<!--
  industrial-servo (plan 9.6b): a PMSM servo motor driving a load disc through a coupling, along +X.

  Z-up, metres, every shaft turns about +X. Joint "rotor_joint" is bound to the motor angle
  Theta/y (rad, the integral of the measured speed). Joint "coupling_joint" is the twist of the
  flexible coupling of the two-mass and full variants, bound to Kc/q (the load angle minus the
  motor angle, rad); the rigid variants (baseline, switching, encoder) have no coupling state, so
  the load disc simply follows the rotor there. The twist is the angle between the two markers.
-->
<sdf version="1.9">
  <model name="industrial_servo">
    <link name="frame">
      <pose>0 0 0 0 0 0</pose>
      <visual name="base_plate">
        <pose>0.05 0 -0.07 0 0 0</pose>
        <geometry><box><size>0.5 0.16 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="motor_housing">
        <pose>-0.06 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="load_pedestal">
        <pose>0.2 0 -0.03 0 0 0</pose>
        <geometry><box><size>0.02 0.06 0.08</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor">
      <pose>0 0 0 0 0 0</pose>
      <visual name="rotor_disc">
        <pose>0.01 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="rotor_marker">
        <pose>0.01 0 0.03 0 0 0</pose>
        <geometry><box><size>0.024 0.008 0.012</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="motor_shaft">
        <pose>0.07 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.14</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>

    <link name="load">
      <pose>0.14 0 0 0 0 0</pose>
      <visual name="load_disc">
        <pose>0.03 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="load_marker">
        <pose>0.03 0 0.05 0 0 0</pose>
        <geometry><box><size>0.034 0.01 0.014</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_joint" type="continuous">
      <parent>frame</parent>
      <child>rotor</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="coupling_joint" type="continuous">
      <parent>rotor</parent>
      <child>load</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
  </model>
</sdf>
