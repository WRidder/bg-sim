<?xml version="1.0"?>
<!--
  reaction-wheel-1d (plan 9.7): a 0.12 m cube balanced on one edge by a reaction wheel.

  Z-up, metres. The edge is the world Y axis through the origin; the cube rotates about it
  (joint "edge", bound to the model's Body/theta). theta = 0 is the balanced attitude: the
  cube stands on its edge with a body diagonal vertical, so its centre is
  l = 0.12 * sqrt(2) / 2 = 0.0849 m (the model's l = 0.085 m) above the edge, which is why the
  cube link is pitched by 45 degrees. Positive theta rotates the cube about +Y (the top
  moves towards +X).

  The wheel is a disk inside the cube on the cube's centre, its axis parallel to the edge
  (joint "wheel_joint", bound to the wheel angle relative to the cube, WheelAngle/y). Its
  spoke makes the rotation visible.
-->
<sdf version="1.9">
  <model name="reaction_wheel_1d">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.4 0.3 0.02</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
      <visual name="edge_rail">
        <pose>0 0 0.004 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.14</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="cube">
      <!-- centre l above the edge, pitched 45 degrees so that an edge points down -->
      <pose>0 0 0.0848528 0 0.7853982 0</pose>
      <visual name="cube_body">
        <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 0.4</diffuse></material>
      </visual>
    </link>

    <link name="wheel">
      <pose>0 0 0.0848528 0 0 0</pose>
      <visual name="wheel_disk">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_spoke">
        <pose>0.025 0 0 0 0 0</pose>
        <geometry><box><size>0.03 0.024 0.008</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- The edge: a pose relative to the child (the cube), at the cube's lowest edge. -->
    <joint name="edge" type="revolute">
      <parent>base</parent>
      <child>cube</child>
      <pose relative_to="cube">0.06 0 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.5707963</lower><upper>1.5707963</upper></limit>
      </axis>
    </joint>

    <!-- The motor shaft: on the cube centre, axis along Y. -->
    <joint name="wheel_joint" type="continuous">
      <parent>cube</parent>
      <child>wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
