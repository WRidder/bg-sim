{
  "project": "wind-turbine",
  "description": "NREL 5 MW reference wind turbine (NREL/TP-500-38060): rotational and translational bond graph with BEM Cp/Ct tables and the baseline controller. Numbers come from design/design.json (BEM, tower finite elements, the controller law in numpy) and from the report's Table 7-1.",
  "models": {
    "wind-turbine-steady": {
      "checks": [
        {
          "kind": "scene_bindings"
        },
        {
          "kind": "no_diagnostics",
          "codes": [
            "W201",
            "W202",
            "E106",
            "W206"
          ],
          "note": "no algebraic loop, no causality conflict, no event storm"
        },
        {
          "kind": "cursor_value",
          "signal": "RotorRPM/y",
          "t": 260.0,
          "value": 9.18894253079884,
          "rtol": 0.02,
          "note": "ramp at 8 m/s: quasi-steady rotor speed (design/design.py); below rated the rotor lags the ramp by about 1.5 %, as its inertia must be spun up"
        },
        {
          "kind": "cursor_value",
          "signal": "ElecPower/y",
          "t": 260.0,
          "value": 1.7904065117762131,
          "rtol": 0.05,
          "note": "quasi-steady electrical power (below rated about 4 % under the steady value: the speed lag, cubed in K w^2 times w)"
        },
        {
          "kind": "cursor_value",
          "signal": "RotorRPM/y",
          "t": 560.0,
          "value": 12.100002305225331,
          "rtol": 0.01,
          "note": "ramp at 14 m/s: quasi-steady rotor speed (design/design.py); below rated the rotor lags the ramp by about 1.5 %, as its inertia must be spun up"
        },
        {
          "kind": "cursor_value",
          "signal": "ElecPower/y",
          "t": 560.0,
          "value": 4.999999839999999,
          "rtol": 0.01,
          "note": "quasi-steady electrical power (below rated about 4 % under the steady value: the speed lag, cubed in K w^2 times w)"
        },
        {
          "kind": "cursor_value",
          "signal": "RotorRPM/y",
          "t": 860.0,
          "value": 12.100002305225331,
          "rtol": 0.01,
          "note": "ramp at 20 m/s: quasi-steady rotor speed (design/design.py); below rated the rotor lags the ramp by about 1.5 %, as its inertia must be spun up"
        },
        {
          "kind": "cursor_value",
          "signal": "ElecPower/y",
          "t": 860.0,
          "value": 4.999999839999999,
          "rtol": 0.01,
          "note": "quasi-steady electrical power (below rated about 4 % under the steady value: the speed lag, cubed in K w^2 times w)"
        },
        {
          "kind": "cursor_value",
          "signal": "Aero/beta_deg",
          "t": 860.0,
          "value": 17.433904782725175,
          "abs": 0.3,
          "note": "pitch at 20 m/s on the ramp"
        },
        {
          "kind": "max_abs_le",
          "signal": "ElecPower/y",
          "value": 5.05,
          "note": "the power never exceeds rated by more than 1 % on the ramp"
        },
        {
          "kind": "energy_ledger",
          "tol": 0.0001,
          "stored": [
            {
              "coeff": 1.2900153738872199e-08,
              "signal": "RotorInertia/P",
              "pow": 2
            },
            {
              "coeff": 0.0009361262347505037,
              "signal": "GenInertia/P",
              "pow": 2
            },
            {
              "coeff": 1.129170109674708e-06,
              "signal": "TowerMass/P",
              "pow": 2
            },
            {
              "coeff": 433818500.0,
              "signal": "ShaftC/q",
              "pow": 2
            },
            {
              "coeff": 904212.1072953058,
              "signal": "TowerSpring/q",
              "pow": 2
            }
          ],
          "note": "every bond's two ports carry opposite power (Tellegen); the kinetic and elastic energy of the two inertias, the tower mass, the shaft and the tower spring changes by the work of the sources (aerodynamic torque, thrust, generator) minus the shaft and tower damping; the balances integrate the port powers with the trapezoid rule on the output grid, so their accuracy is set by how many samples per period of the 2.2 Hz shaft oscillation the model records (tol 1e-3 for the step and turbulent runs, 20 to 40 samples per second)"
        }
      ]
    },
