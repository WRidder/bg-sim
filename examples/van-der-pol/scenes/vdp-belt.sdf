<?xml version="1.0"?>
<!--
  vdp-belt: a block on a spring rides a belt (Z up, metres). The prismatic joint "block" (axis +X) is
  the block position x, 0 at the unstretched spring (the block's left face 0.08 m from the wall); it
  oscillates about x_s = 0.1892 m by +-4.5 mm. The joints coil1..coil8 move the spring's rings by
  k/(n+1) of x; "belt" moves the belt's stripes by the belt phase (a sawtooth over one stripe pitch).
  The block is coloured by the slip velocity. Written by examples/van-der-pol/design/build_model.py.
-->
<sdf version="1.9">
  <model name="vdp_belt">
    <link name="rig">
      <pose>0 0 0 0 0 0</pose>
      <visual name="table">
        <pose>0.1500 0 0.005 0 0 0</pose>
        <geometry><box><size>0.6600 0.2000 0.0100</size></box></geometry>
        <material><diffuse>0.28 0.30 0.34 1</diffuse></material>
      </visual>
      <visual name="wall">
        <pose>-0.0900 0 0.1200 0 0 0</pose>
        <geometry><box><size>0.0200 0.1200 0.1200</size></box></geometry>
        <material><diffuse>0.62 0.64 0.68 1</diffuse></material>
      </visual>
      <visual name="wall_foot">
        <pose>-0.0900 0 0.0350 0 0 0</pose>
        <geometry><box><size>0.0200 0.1200 0.0600</size></box></geometry>
        <material><diffuse>0.50 0.52 0.56 1</diffuse></material>
      </visual>
      <visual name="belt_top">
        <pose>0.1500 0 0.0560 0 0 0</pose>
        <geometry><box><size>0.5400 0.0800 0.0080</size></box></geometry>
        <material><diffuse>0.10 0.10 0.11 1</diffuse></material>
      </visual>
      <visual name="belt_bottom">
        <pose>0.1500 0 0.026 0 0 0</pose>
        <geometry><box><size>0.5400 0.0800 0.0080</size></box></geometry>
        <material><diffuse>0.10 0.10 0.11 1</diffuse></material>
      </visual>
      <visual name="pulley_left">
        <pose>-0.1200 0 0.043 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0170</radius><length>0.0860</length></cylinder></geometry>
        <material><diffuse>0.70 0.72 0.76 1</diffuse></material>
      </visual>
      <visual name="pulley_left_hub">
        <pose>-0.1200 0.046 0.043 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0060</radius><length>0.0100</length></cylinder></geometry>
        <material><diffuse>0.85 0.6 0.15 1</diffuse></material>
      </visual>
      <visual name="pulley_right">
        <pose>0.4200 0 0.043 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0170</radius><length>0.0860</length></cylinder></geometry>
        <material><diffuse>0.70 0.72 0.76 1</diffuse></material>
      </visual>
      <visual name="pulley_right_hub">
        <pose>0.4200 0.046 0.043 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0060</radius><length>0.0100</length></cylinder></geometry>
        <material><diffuse>0.85 0.6 0.15 1</diffuse></material>
      </visual>
      <visual name="pad_bracket">
        <pose>0.2150 0 0.1550 0 0 0</pose>
        <geometry><box><size>0.0120 0.1100 0.0120</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
      <visual name="pad_post_a">
        <pose>0.2150 0.05 0.1050 0 0 0</pose>
        <geometry><box><size>0.0120 0.0100 0.1000</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>
