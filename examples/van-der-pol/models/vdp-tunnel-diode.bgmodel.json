    },
    {
      "name": "V_v",
      "value": "0.355",
      "unit": "V",
      "description": "Valley voltage"
    },
    {
      "name": "V0",
      "value": "0.5*(V_p + V_v)",
      "unit": "V",
      "description": "Bias point: midpoint of the negative-resistance region (set by the DC supply)"
    },
    {
      "name": "A",
      "value": "0.5*(V_v - V_p)",
      "unit": "V",
      "description": "Amplitude scale sqrt(a/(3 b)): half the peak-to-valley voltage"
    },
    {
      "name": "a",
      "value": "3.0*(I_p - I_v)/(4.0*A)",
      "unit": "A/V",
      "description": "Negative conductance at the bias point (the diode is -1/a = -47 Ohm there)"
    },
    {
      "name": "b",
      "value": "a/(3.0*A*A)",
      "unit": "A/V^3",
      "description": "Cubic coefficient: the fit's extrema sit at the peak and the valley"
    },
    {
      "name": "f0",
      "value": "10000000.0",
      "unit": "Hz",
      "description": "Tank resonance 1/(2 pi sqrt(L C))"
    },
    {
      "name": "w0",
      "value": "6.283185307179586*f0",
      "unit": "rad/s",
      "description": "Time scale of the Van der Pol form: tau = w0 t"
    },
    {
      "name": "mu",
      "value": "1.0",
      "unit": null,
      "description": "Van der Pol parameter mu = a sqrt(L/C)"
    },
    {
      "name": "Z0",
      "value": "mu/a",
      "unit": "Ohm",
      "description": "Tank characteristic impedance sqrt(L/C) that gives this mu"
    },
    {
      "name": "L",
      "value": "Z0/w0",
      "unit": "H",
      "description": "Tank inductance"
    },
    {
      "name": "C",
      "value": "1.0/(Z0*w0)",
      "unit": "F",
      "description": "Tank capacitance"
    },
    {
      "name": "x0",
      "value": "0.5",
      "unit": null,
      "description": "Start voltage in units of A (x(0) = x0, x'(0) = 0)"
    },
    {
      "name": "v0",
      "value": "A*x0",
      "unit": "V",
      "description": "Start voltage of the tank capacitor"
    },
    {
      "name": "iL0",
      "value": "a*v0 - b*v0^3",
      "unit": "A",
      "description": "Start inductor current: the diode current, so the capacitor current is 0 (x'(0) = 0)"
    }
  ],
