    {
      "name": "F_n",
      "value": "40.0",
      "unit": "N",
      "description": "Normal force on the belt (the block's weight and a spring-loaded pressure pad)"
    },
    {
      "name": "mu_c",
      "value": "0.3",
      "unit": null,
      "description": "Coulomb (kinetic) friction coefficient"
    },
    {
      "name": "mu_s",
      "value": "0.45",
      "unit": null,
      "description": "Static friction coefficient"
    },
    {
      "name": "v_s",
      "value": "0.1",
      "unit": "m/s",
      "description": "Stribeck velocity of the Gaussian drop exp(-(w/v_s)^2)"
    },
    {
      "name": "v_eps",
      "value": "0.001",
      "unit": "m/s",
      "description": "Smooth-sign velocity of the Stribeck block"
    },
    {
      "name": "v_b",
      "value": "v_s/sqrt(2.0)",
      "unit": "m/s",
      "description": "Belt speed: the inflection point of the Stribeck drop"
    },
    {
      "name": "w0",
      "value": "sqrt(k/m)",
      "unit": "rad/s",
      "description": "Time scale of the Van der Pol form: tau = w0 t"
    },
    {
      "name": "mu",
      "value": "0.5",
      "unit": null,
      "description": "Van der Pol parameter mu = alpha/sqrt(k m) (chosen; sets sigma)"
    },
    {
      "name": "alpha_f",
      "value": "F_n*(mu_s - mu_c)*sqrt(2.0)*exp(-0.5)/v_s",
      "unit": "N*s/m",
      "description": "Falling slope of the Stribeck drop at v_b"
    },
    {
      "name": "alpha",
      "value": "mu*sqrt(k*m)",
      "unit": "N*s/m",
      "description": "Net falling slope of the friction curve at v_b"
    },
    {
      "name": "sigma",
      "value": "alpha_f - alpha",
      "unit": "N*s/m",
      "description": "Viscous friction coefficient"
    },
    {
      "name": "beta",
      "value": "F_n*(mu_s - mu_c)*4.0*sqrt(2.0)*exp(-0.5)/(6.0*v_s^3)",
      "unit": "N*s^3/m^3",
      "description": "Cubic coefficient F'''(v_b)/6"
    },
    {
      "name": "F0",
      "value": "F_n*(mu_c + (mu_s - mu_c)*exp(-0.5)) + sigma*v_b",
      "unit": "N",
      "description": "Friction force at the belt speed"
    },
    {
      "name": "x_s",
      "value": "F0/k",
      "unit": "m",
      "description": "Spring stretch at the force balance F0 = k x_s"
    },
    {
      "name": "V",
      "value": "sqrt(alpha/(3.0*beta))",
      "unit": "m/s",
      "description": "Velocity scale: x_vdp = x'/V"
    },
    {
      "name": "x0",
      "value": "0.5",
      "unit": null,
      "description": "Start velocity in units of V (the block starts at x_s)"
    },
    {
      "name": "xd0",
      "value": "V*x0",
      "unit": "m/s",
      "description": "Start velocity of the block"
    }
  ],
