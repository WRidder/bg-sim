<?xml version="1.0"?>
<!--
  a109-sim: the flyable A109 (red, framed). The floor is the ground (sea level); the gear
  stands 1.3 m below the CG.
  Generated by design/build_model.py. Z-up, metres; x north, y west. The view keeps the first helicopter
  framed by moving the world instead of the camera (block HeliView): every pose is relative to that
  helicopter's position, the others fly in formation slots beside it, and a helicopter in steady forward
  flight is shown relative to its trimmed path. The airframe is built from simple solids (cabin, nose,
  tail cone, boom, fin, tailplane, engine fairing, tricycle gear). The main rotor (link rotor_*) sits at
  the hub, tilted with the shaft (6.3 deg forward) and with the flapping a1, b1; the blades and the tail
  rotor (link tailrotor_*) turn at a tenth of their real speed, so they do not strobe in a video.
-->
<sdf version="1.9">
  <model name="a109-sim">
    <link name="ground">
      <pose>0 0 -9 0 0 0</pose>
      <visual name="floor">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry><box><size>120 120 1</size></box></geometry>
        <material><diffuse>0.36 0.45 0.33 1</diffuse></material>
      </visual>
      <visual name="stripe_x0">
        <pose>-60 0 0.02 0 0 0</pose>
        <geometry><box><size>1 120 0.04</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
