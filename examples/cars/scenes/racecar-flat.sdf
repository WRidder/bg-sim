<?xml version="1.0"?>
<!--
  Race car on the test pad (600 m grid, 2 km straight).
  Generated by design/make_scenes.py. Z up, metres. The car stays near the origin: the
  link "world" (the ground) moves under it by minus the chassis' horizontal position,
  bound to View/ground; "chassis" to View/body, "wheel_xx" (spinning) to View/w1..w4,
  "hub_xx" (upright and brake) to View/c1..c4. Link poses: the car at rest.
-->
<sdf version="1.9">
  <model name="racecar-flat">
    <link name="world">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/flat.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="chassis">
      <pose>0 0 0.3000 0 0 0</pose>
      <visual name="body">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_body.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_fl">
      <pose>1.6650 0.8000 0.3241 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_fl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_fl">
      <pose>1.6650 0.8000 0.3241 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_fl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_fr">
      <pose>1.6650 -0.8000 0.3241 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_fr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_fr">
      <pose>1.6650 -0.8000 0.3241 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_fr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_rl">
      <pose>-1.1350 0.7750 0.3222 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_rl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_rl">
      <pose>-1.1350 0.7750 0.3222 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_rl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_rr">
      <pose>-1.1350 -0.7750 0.3222 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_rr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_rr">
      <pose>-1.1350 -0.7750 0.3222 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_rr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/racecar_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
