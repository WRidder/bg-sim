<?xml version="1.0"?>
<!--
  Buggy on the rolling hills of design/hills.json.
  Generated by design/make_scenes.py. Z up, metres. The car stays near the origin: the
  link "world" (the ground) moves under it by minus the chassis' horizontal position,
  bound to View/ground; "chassis" to View/body, "wheel_xx" (spinning) to View/w1..w4,
  "hub_xx" (upright and brake) to View/c1..c4. Link poses: the car at rest. The suspension
  rods (visual "suspension" of the chassis) are drawn at rest: they join the chassis to the
  carriers, so a moving wheel leaves them by its travel (car-sim draws them from both ends).
-->
<sdf version="1.9">
  <model name="buggy-hills">
    <link name="world">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/hills.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="chassis">
      <pose>0 0 0.7500 0 0 0</pose>
      <visual name="body">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_body.glb</uri></mesh></geometry>
      </visual>
      <visual name="suspension">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_suspension.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_fl">
      <pose>1.5530 0.8750 0.4075 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_fl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_fl">
      <pose>1.5530 0.8750 0.4075 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_fl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_fr">
      <pose>1.5530 -0.8750 0.4075 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_fr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_fr">
      <pose>1.5530 -0.8750 0.4075 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_fr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_rl">
      <pose>-1.1470 0.8750 0.4047 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_rl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_rl">
      <pose>-1.1470 0.8750 0.4047 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_rl_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="wheel_rr">
      <pose>-1.1470 -0.8750 0.4047 -1.570796 0.000000 0.000000</pose>
      <visual name="wheel_rr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_wheel.glb</uri></mesh></geometry>
      </visual>
    </link>
    <link name="hub_rr">
      <pose>-1.1470 -0.8750 0.4047 -1.570796 0.000000 0.000000</pose>
      <visual name="hub_rr_v">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/buggy_hub.glb</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
