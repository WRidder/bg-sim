<?xml version="1.0"?>
<!--
  reaction-wheel-3d (plan 9.10, X-MB4): a rigid body on a spherical pivot with four reaction wheels
  in a pyramid.

  Z-up, metres, the world frame of the model. The pivot is the world origin and the body hangs with
  its centre of mass 0.2 m below it. The body and the four wheels are bound by their world pose,
  (qw, qx, qy, qz, x, y, z) as the model composes them: link "body" follows PoseBody/g[1..7] and
  link "wheel_k" follows PoseW<k>/g[1..7], the pose that feeds the wheel's own gravity block. The
  wheel frame has its z axis along the spin axis, so the disc (a cylinder, whose axis is z) spins
  in place and a marker on its rim shows the rotation.
  The poses of the links below are those poses at the start of the run.
  The body box is the principal-inertia equivalent of the model (m = 2 kg, J = 0.06 / 0.05 /
  0.04 kg m^2 gives 0.3 x 0.387298 x 0.458258 m); it is translucent so that the wheels are visible. The wheel
  discs are drawn with a 0.07 m radius (the real 0.3 kg, 0.002 kg m^2 wheel would be 0.115 m wide
  and would touch its neighbours).
-->
<sdf version="1.9">
  <model name="reaction_wheel_3d">
    <link name="stand">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pivot_ball">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="stand_post">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="stand_base">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>

    <link name="body">
      <pose>0 0 -0.2 0 0 0</pose>
      <visual name="body_box">
        <geometry><box><size>0.3 0.387298 0.458258</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 0.3</diffuse></material>
      </visual>
      <visual name="body_rod">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_1">
      <pose>0.1 0 -0.2 0 0.955317 0</pose>
      <visual name="wheel_1_disc">
        <geometry><cylinder><radius>0.07</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_1_marker">
        <pose>0.045 0 0.013 0 0 0</pose>
        <geometry><box><size>0.04 0.012 0.008</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_2">
      <pose>0 0.1 -0.2 0 0.955317 1.570796</pose>
      <visual name="wheel_2_disc">
        <geometry><cylinder><radius>0.07</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="wheel_2_marker">
        <pose>0.045 0 0.013 0 0 0</pose>
        <geometry><box><size>0.04 0.012 0.008</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_3">
      <pose>-0.1 0 -0.2 0 0.955317 3.141593</pose>
      <visual name="wheel_3_disc">
        <geometry><cylinder><radius>0.07</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.9 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="wheel_3_marker">
        <pose>0.045 0 0.013 0 0 0</pose>
        <geometry><box><size>0.04 0.012 0.008</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_4">
      <pose>0 -0.1 -0.2 0 0.955317 -1.570796</pose>
      <visual name="wheel_4_disc">
        <geometry><cylinder><radius>0.07</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.6 0.45 0.85 1</diffuse></material>
      </visual>
      <visual name="wheel_4_marker">
        <pose>0.045 0 0.013 0 0 0</pose>
        <geometry><box><size>0.04 0.012 0.008</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
