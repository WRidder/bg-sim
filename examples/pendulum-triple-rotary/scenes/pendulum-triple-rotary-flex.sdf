<?xml version="1.0"?>
<!--
  pendulum-triple-rotary-flex: the rotary triple pendulum on a flexible arm (a 3 x 50 mm steel strip on edge).

  Z-up, metres. Every moving link is placed by a pose binding (no joints): the frames are the model's.
    arm_bar  Arm/pose    the beam's reference frame = end A at the motor axis, x along the arm, z up
    arm_tip  Arm/poseB   end B (deflected and turned with the tip slopes and the twist): the hinge housing
    rodK     L{K+1}/W/g  the pendulum joint K's child frame: x along the link, z = the hinge axis
  The strip `arm_strip` (a box from the hub, end A, to the tip, end B: beam axis +x, beam y +y, length
  0.2159 m) is deformed by Arm/eta_y[1..2] (horizontal bending), Arm/eta_z[1..2] (vertical) and
  Arm/eta_t[1..1] (torsion), clamped-free basis. The scene is drawn at q = 0: the links upright.
-->
<sdf version="1.9">
  <model name="pendulum_triple_rotary_flex">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="servo_housing">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.12</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="base_plate">
        <pose>0 0 -0.125 0 0 0</pose>
        <geometry><box><size>0.34 0.24 0.01</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="arm_bar">
      <pose>0 0 0 0 0 0</pose>
      <visual name="hub">
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="arm_strip">
        <pose>0.10795 0 0 0 0 0</pose>
        <geometry><box><size>0.2159 0.003 0.05</size></box></geometry>
        <material><diffuse>0.72 0.74 0.78 1</diffuse></material>
      </visual>
    </link>
    <link name="arm_tip">
      <pose>0.2159 0 0 0 0 0</pose>
      <visual name="tip_block">
        <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod1">
      <pose>0.2159 0 0.0 3.1415927 -1.5707963 0</pose>
      <visual name="rod1">
        <pose>0.1 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="joint1">
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod2">
      <pose>0.2159 0 0.2 3.1415927 -1.5707963 0</pose>
      <visual name="rod2">
        <pose>0.1 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.85 0.35 0.3 1</diffuse></material>
      </visual>
      <visual name="joint2">
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod3">
      <pose>0.2159 0 0.4 3.1415927 -1.5707963 0</pose>
      <visual name="rod3">
        <pose>0.16825 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.3365</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.2 1</diffuse></material>
      </visual>
      <visual name="joint3">
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="tip">
        <pose>0.3365 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
