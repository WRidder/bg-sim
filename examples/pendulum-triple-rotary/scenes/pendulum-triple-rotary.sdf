<?xml version="1.0"?>
<!--
  pendulum-triple-rotary (X5.13): a Quanser-style rotary arm with a chain of 3 pendulum links.

  Z-up, metres. The scene is drawn at q = 0: the arm along +X from the vertical axis, the links
  standing upright (+Z) on its tip. The arm turns about +Z (joint arm, the model's J1/qout). The
  links swing about the arm axis, joint axis +X (J2/qout ... : a positive angle tilts the chain
  towards -Y, relative to the link below). The model's hanging start is q2 = pi.
-->
<sdf version="1.9">
  <model name="pendulum_triple_rotary">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="servo_housing">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.12</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="base_plate">
        <pose>0 0 -0.125 0 0 0</pose>
        <geometry><box><size>0.34 0.24 0.01</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="arm_bar">
      <pose>0 0 0 0 0 0</pose>
      <visual name="hub">
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="arm_bar">
        <pose>0.10795 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.2159</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="tip_block">
        <pose>0.2159 0 0 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod1">
      <pose>0.2159 0 0 0 0 0</pose>
      <visual name="rod1">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="joint1">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod2">
      <pose>0.2159 0 0.2 0 0 0</pose>
      <visual name="rod2">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.85 0.35 0.3 1</diffuse></material>
      </visual>
      <visual name="joint2">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>
    <link name="rod3">
      <pose>0.2159 0 0.4 0 0 0</pose>
      <visual name="rod3">
        <pose>0 0 0.16825 0 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.3365</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.2 1</diffuse></material>
      </visual>
      <visual name="joint3">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="tip">
        <pose>0 0 0.3365 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="arm" type="revolute">
      <parent>base</parent>
      <child>arm_bar</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-6.2831853</lower><upper>6.2831853</upper></limit></axis>
    </joint>
    <joint name="link1" type="revolute">
      <parent>arm_bar</parent>
      <child>rod1</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-9.4247780</lower><upper>9.4247780</upper></limit></axis>
    </joint>
    <joint name="link2" type="revolute">
      <parent>rod1</parent>
      <child>rod2</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-9.4247780</lower><upper>9.4247780</upper></limit></axis>
    </joint>
    <joint name="link3" type="revolute">
      <parent>rod2</parent>
      <child>rod3</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-9.4247780</lower><upper>9.4247780</upper></limit></axis>
    </joint>
  </model>
</sdf>
