<?xml version="1.0"?>
<!--
  pendulum-double-fixed (X5.11): a fixed-pivot pendulum with 2 links in the vertical X-Z plane.

  The model is planar in its x-y plane with gravity along -y. The scene uses the SDF X-Z plane: model x is
  SDF x, model y is SDF z, and the model's counter-clockwise joint angles are rotations about -Y (rotating +X
  towards +Z). Joint 1 is the motor-driven pivot at the world origin; its angle q1 is the absolute angle of
  link 1 from +X (hanging down: -pi/2, upright: +pi/2). Joints 2.. are the passive joints at the end of each
  link; their angles are relative to the previous link (0: straight). The links are bars of length
  0.3 m, 0.36 m (centre of mass at the middle).
  Joint k is bound to Joint<k>/qout in the model's bindings.
-->
<sdf version="1.9">
  <model name="pendulum_double_fixed">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="motor_housing">
        <pose>0 -0.07 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.09</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.34 1</diffuse></material>
      </visual>
      <visual name="gearbox">
        <pose>0 -0.025 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.6 0.6 0.62 1</diffuse></material>
      </visual>
      <visual name="column">
        <pose>0 -0.07 -0.2 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.36</size></box></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="floor">
        <pose>0 -0.07 -0.39 0 0 0</pose>
        <geometry><box><size>0.5 0.3 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>

    <link name="link1">
      <pose>0 0 0 0 0 0</pose>
      <visual name="link1_bar">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.032 0.032</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="joint1_hub">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.052</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="link2">
      <pose>0.3 0 0 0 0 0</pose>
      <visual name="link2_bar">
        <pose>0.18 0 0 0 0 0</pose>
        <geometry><box><size>0.36 0.026 0.026</size></box></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="joint2_hub">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.046</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="tip_mass">
        <pose>0.36 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.022</radius></sphere></geometry>
        <material><diffuse>0.85 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="joint1" type="revolute">
      <parent>base</parent>
      <child>link1</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="joint2" type="revolute">
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
