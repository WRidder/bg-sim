<?xml version="1.0"?>
<!--
  reaction-wheel-2d (plan 9.10, X-MB2): the planar reaction-wheel balancer in the X-Z plane.

  The model is planar in its x-y plane with gravity along -y. The scene uses the SDF X-Z plane:
  model x is SDF x, model y is SDF z, and the model's counter-clockwise angles are rotations about
  -Y (rotating +X towards +Z). The pivot is the world origin and the body stands upright at q = 0;
  its centre of mass is 0.3 m above the pivot and the wheel axis 0.5 m above it. A positive q
  tilts the body towards -X. Joint "pivot" is bound to the body angle q, joint "wheel_axis" to the
  wheel angle relative to the body, both in rad. The wheel is a disc of 0.1 m radius
  (m = 0.4 kg, J = 0.002 kg m^2) with a spoke that makes its rotation visible.
-->
<sdf version="1.9">
  <model name="reaction_wheel_2d">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground_slab">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry><box><size>0.6 0.3 0.04</size></box></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
    </link>

    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <visual name="body_bar">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.5</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="pivot_pin">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.09</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel">
      <pose>0 0 0.5 0 0 0</pose>
      <visual name="wheel_disc">
        <pose>0 0.045 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_spoke">
        <pose>0.06 0.045 0 0 0 0</pose>
        <geometry><box><size>0.08 0.034 0.014</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="pivot" type="revolute">
      <parent>ground</parent>
      <child>body</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="wheel_axis" type="continuous">
      <parent>body</parent>
      <child>wheel</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
