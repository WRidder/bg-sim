<?xml version="1.0"?>
<!--
  quarter-car (plan 9.4): the road, the unsprung wheel and the sprung body, side view in the X-Z plane.

  Z-up, metres. All three moving links are prismatic along +Z from the ground link and are bound to
  the absolute vertical positions of the model, measured from static equilibrium (zero at rest):
    joint road     RoadInt/y   the road surface (plateau bump of 0.05 m)
    joint wheel    UInt/y      the unsprung mass (40 kg)
    joint body     SInt/y      the sprung mass (300 kg)
  At rest the road surface is z = 0, the wheel centre 0.3 m and the body centre 0.6 m high. The
  strut drawn on the wheel is decoration; the suspension travel is the gap between wheel and body.
-->
<sdf version="1.9">
  <model name="quarter_car">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground_slab">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>1.4 0.6 0.04</size></box></geometry>
        <material><diffuse>0.4 0.42 0.45 1</diffuse></material>
      </visual>
    </link>

    <link name="road">
      <pose>0 0 0 0 0 0</pose>
      <visual name="road_surface">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>1.2 0.5 0.1</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel">
      <pose>0 0 0.3 0 0 0</pose>
      <visual name="tire">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.12</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.13</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
      <visual name="strut">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.3</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="body">
      <pose>0 0 0.62 0 0 0</pose>
      <visual name="body_box">
        <geometry><box><size>0.7 0.36 0.16</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
    </link>

    <joint name="road_joint" type="prismatic">
      <parent>ground</parent>
      <child>road</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="wheel_joint" type="prismatic">
      <parent>ground</parent>
      <child>wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="body_joint" type="prismatic">
      <parent>ground</parent>
      <child>body</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
  </model>
</sdf>
