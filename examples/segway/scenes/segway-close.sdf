<?xml version="1.0"?>
<!--
      segway: a two-wheeled self-balancing personal transporter with a rider. Generated by
      design/build_scene.py. Z-up, metres, the world frame of the model.

      "body" (frame at the body's centre of mass, 0.52 m above the axle; x forward, y left) follows
      Pose/q*, Pose/p*; "wheel_l" and "wheel_r" (frame at the wheel centre, z along the axle) follow
      PoseWL/g and PoseWR/g, so the wheels roll visibly: the dark spoke on each hub shows the rotation.
      The body link carries the platform, the two fenders, the battery box, the steering post with
      its handlebar and the rider (feet, legs, torso, arms, head). The ground is 2 m tiles, a 4 m square around the start.
    -->
<sdf version="1.9">
  <model name="segway">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="tile_00_00">
        <pose>-1.0000 -1.0000 -0.0080 0.00000 0.00000 0.00000</pose>
        <geometry><box><size>2 2 0.01</size></box></geometry>
        <material><diffuse>0.8 0.82 0.78 1</diffuse></material>
      </visual>
      <visual name="tile_00_01">
        <pose>-1.0000 1.0000 -0.0080 0.00000 0.00000 0.00000</pose>
