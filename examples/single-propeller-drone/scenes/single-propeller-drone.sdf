<?xml version="1.0"?>
<!--
  single-propeller-drone: a swashplateless mono-rotor. One motor on top of a finned body tube; no
  servos. The four red fins sit in the rotor slipstream (inside the contracted wake) at their
  trim incidence and carry the motor reaction. The body link is the airframe frame at the centre
  of mass (x forward, y left, z up); its pose is bound to the seven pose signals. The propeller
  link turns about body z on joint "rotor", bound to the rotor azimuth. Every dimension comes from
  design/design.py (generated by design/build_model.py).

  Z-up, metres.
-->
<sdf version="1.9">
  <model name="single_propeller_drone">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0.75 0.75 -0.01 0 0 0</pose>
        <geometry><box><size>4 4 0.02</size></box></geometry>
        <material><diffuse>0.62 0.64 0.66 1</diffuse></material>
      </visual>
      <visual name="pad">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <visual name="pad_land">
        <pose>1.5 1.5 0.003 0 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.9 0.75 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <visual name="fuselage">
        <pose>0 0 -0.010833 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.26</length></cylinder></geometry>
        <material><diffuse>0.72 0.12 0.10 1</diffuse></material>
      </visual>
      <visual name="nose">
        <pose>0.05 0 0.049167 0 0 0</pose>
        <geometry><box><size>0.03 0.04 0.03</size></box></geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="beacon">
        <pose>0 0 0.12517 0 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="mount">
        <pose>0 0 0.13167 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.025</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="fin_1">
        <pose>0.08 0 -0.070833 -0.2014697 0 0</pose>
        <geometry><box><size>0.05 0.004 0.18</size></box></geometry>
        <material><diffuse>0.78 0.10 0.08 1</diffuse></material>
      </visual>
      <visual name="fin_2">
        <pose>4.8986e-18 0.08 -0.070833 -0.2014697 0 1.570796</pose>
        <geometry><box><size>0.05 0.004 0.18</size></box></geometry>
        <material><diffuse>0.78 0.10 0.08 1</diffuse></material>
      </visual>
      <visual name="fin_3">
        <pose>-0.08 9.7972e-18 -0.070833 -0.2014697 0 3.141593</pose>
        <geometry><box><size>0.05 0.004 0.18</size></box></geometry>
        <material><diffuse>0.78 0.10 0.08 1</diffuse></material>
      </visual>
      <visual name="fin_4">
        <pose>-1.4696e-17 -0.08 -0.070833 -0.2014697 0 4.712389</pose>
        <geometry><box><size>0.05 0.004 0.18</size></box></geometry>
        <material><diffuse>0.78 0.10 0.08 1</diffuse></material>
      </visual>
      <visual name="strut_1">
        <pose>-0.05 -0.05 -0.15633 1.355006 0 -0.7853982</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.14478</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="foot_1">
        <pose>-0.1 -0.1 -0.17183 0 0 0</pose>
        <geometry><sphere><radius>0.009</radius></sphere></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="strut_2">
        <pose>0.05 -0.05 -0.15633 1.355006 0 0.7853982</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.14478</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="foot_2">
        <pose>0.1 -0.1 -0.17183 0 0 0</pose>
        <geometry><sphere><radius>0.009</radius></sphere></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="strut_3">
        <pose>0.05 0.05 -0.15633 1.355006 0 2.356194</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.14478</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="foot_3">
        <pose>0.1 0.1 -0.17183 0 0 0</pose>
        <geometry><sphere><radius>0.009</radius></sphere></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="strut_4">
        <pose>-0.05 0.05 -0.15633 1.355006 0 3.926991</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.14478</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="foot_4">
        <pose>-0.1 0.1 -0.17183 0 0 0</pose>
        <geometry><sphere><radius>0.009</radius></sphere></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="motor">
        <pose>0 0 0.14417 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.55 0.55 0.58 1</diffuse></material>
      </visual>
      <visual name="motor_bell">
        <pose>0 0 0.16717 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.014</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.27 1</diffuse></material>
      </visual>
    </link>

    <link name="propeller">
      <pose>0 0 0.17917 0 0 0</pose>
      <visual name="hub">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="blades">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.3048 0.02 0.0035</size></box></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="tip_a">
        <pose>0.1324 0 0 0 0 0</pose>
        <geometry><box><size>0.04 0.021 0.004</size></box></geometry>
        <material><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
      <visual name="tip_b">
        <pose>-0.1324 0 0 0 0 0</pose>
        <geometry><box><size>0.04 0.021 0.004</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor" type="continuous">
      <parent>body</parent>
      <child>propeller</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
  </model>
</sdf>
