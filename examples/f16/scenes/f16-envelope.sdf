<?xml version="1.0"?>
<!--
  f16-envelope: Protected (grey, framed) and Unprotected (sand, right).
  Generated by design/build_model.py. Z-up, metres; x north, y west. The view keeps the first aircraft
  framed by moving the world instead of the camera: every pose is relative to that aircraft's position
  (blocks F16View and F16Trail). The other aircraft fly in formation slots 30 m to the side, so that
  aircraft that start together do not overlap. The floor is a reference plane 150 m below the start
  altitude of the first aircraft: it follows climbs and descents of up to 100 m (then it stays in view as
  an attitude reference), and its 50 m stripes scroll with the ground track. The dots behind each aircraft are its flight path over the last second. The
  stabilators (links stabilator_*, revolute joints stab_*) turn with the servo deflection: positive
  elevator is trailing edge down, a negative rotation about the body y axis (left), hence gain -pi/180.
-->
<sdf version="1.9">
  <model name="f16-envelope">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry><box><size>600 600 1</size></box></geometry>
        <material><diffuse>0.36 0.45 0.33 1</diffuse></material>
      </visual>
      <visual name="stripe_x0">
        <pose>-300 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_y0">
        <pose>0 -300 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x1">
        <pose>-250 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
