      <visual name="stripe_y7">
        <pose>0 75 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_y8">
        <pose>0 125 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_y9">
        <pose>0 175 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_y10">
        <pose>0 225 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_y11">
        <pose>0 275 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="bounds">
      <pose>0 0 0 0 0 0</pose>
      <visual name="bound_0">
        <pose>360 360 368 0 0 0</pose>
        <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
        <material><diffuse>0 0 0 0</diffuse></material>
      </visual>
      <visual name="bound_1">
        <pose>-360 -360 -352 0 0 0</pose>
        <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
        <material><diffuse>0 0 0 0</diffuse></material>
      </visual>
    </link>
    <link name="ac_sim">
      <pose>0 0 0 0 0 0</pose>
      <visual name="airframe_sim">
