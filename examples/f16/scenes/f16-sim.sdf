<?xml version="1.0"?>
<!--
  f16-sim: the flyable F-16 (grey, framed).
  Generated by design/build_model.py. Z-up, metres; x north, y west. The view keeps the first aircraft
  framed by moving the world instead of the camera: every pose is relative to that aircraft's position
  (blocks F16View and F16Trail). The other aircraft fly in formation slots 30 m to the side, so that
  aircraft that start together do not overlap. The floor is a reference plane 150 m below the start
  altitude of the first aircraft: it follows climbs and descents of up to 100 m (then it stays in view as
  an attitude reference), and its 50 m stripes (links stripes_x, stripes_y) scroll with the ground track, each
  set along its own axis, wrapped into one stripe spacing (the bindings declare that period, so the view
  interpolates across a wrap the short way). The dots behind each aircraft are its flight path over the last second. The
  stabilators (links stabilator_*, revolute joints stab_*) turn with the servo deflection: positive
  elevator is trailing edge down, a negative rotation about the body y axis (left), hence gain -pi/180.
  The flaperons (the ailerons) and the rudder turn on their hinge lines (links flap_l_sim, flap_r_sim,
  rudder_sim; a positive rotation lifts the trailing edge of a flaperon and moves the rudder's to the
  right). A positive aileron rolls left: right trailing edge down, left up, hence gains -pi/180 (right)
  and +pi/180 (left); a positive rudder yaws left: trailing edge left, gain -pi/180.
-->
<sdf version="1.9">
  <model name="f16-sim">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry><box><size>603 603 1</size></box></geometry>
        <material><diffuse>0.36 0.45 0.33 1</diffuse></material>
      </visual>
    </link>
    <link name="stripes_x">
      <pose>0 0 0 0 0 0</pose>
      <visual name="stripe_x0">
        <pose>-275 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x1">
        <pose>-225 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x2">
        <pose>-175 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x3">
        <pose>-125 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x4">
        <pose>-75 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x5">
        <pose>-25 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x6">
        <pose>25 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x7">
        <pose>75 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x8">
        <pose>125 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x9">
        <pose>175 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
      </visual>
      <visual name="stripe_x10">
        <pose>225 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.62 0.66 0.55 1</diffuse></material>
