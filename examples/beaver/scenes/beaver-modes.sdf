<?xml version="1.0"?>
<!--
  beaver-modes: Phugoid (yellow, framed), ShortPeriod (red), DutchRoll (blue), Roll (white), Spiral (green).
  Generated by design/build_model.py. Z-up, metres; x north, y west. The view keeps the first aircraft
  framed by moving the world instead of the camera: every pose is relative to that aircraft's position
  (blocks BeaverView and BeaverTrail). Other aircraft fly in formation slots 25 m to the side. The floor
  is a reference plane 150 m below the start altitude of the first aircraft; it follows climbs and
  descents of up to 100 m and its 50 m stripes scroll with the ground track. The dots behind each
  aircraft are its flight path over the last seconds. The control surfaces turn on their hinge lines
  (links elevator_*, aileron_l_*, ..., joints *_hinge): elevator and flaps trailing edge down = a negative
  rotation about the body y axis (left), the ailerons split da = da_right - da_left half and half, the
  rudder's trailing edge left (positive dr) = a negative rotation about z. The propeller turns at 1/20
  of the shaft speed (the true 30 rev/s would alias at the display rate). The floats are decoration:
  the model has no water or ground contact.
-->
<sdf version="1.9">
  <model name="beaver-modes">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry><box><size>600 600 1</size></box></geometry>
        <material><diffuse>0.30 0.42 0.52 1</diffuse></material>
      </visual>
      <visual name="stripe_x0">
        <pose>-300 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.52 0.62 0.68 1</diffuse></material>
      </visual>
      <visual name="stripe_y0">
        <pose>0 -300 0.05 0 0 0</pose>
        <geometry><box><size>600 3 0.1</size></box></geometry>
        <material><diffuse>0.52 0.62 0.68 1</diffuse></material>
      </visual>
      <visual name="stripe_x1">
        <pose>-250 0 0.05 0 0 0</pose>
        <geometry><box><size>3 600 0.1</size></box></geometry>
        <material><diffuse>0.52 0.62 0.68 1</diffuse></material>
      </visual>
