      "description": "Length of every beam, wall to tip"
    },
    {
      "name": "zeta",
      "value": "0.02",
      "unit": null,
      "description": "Modal damping ratio, every mode of every beam"
    },
    {
      "name": "g0",
      "value": "0.0",
      "unit": "m/s^2",
      "description": "Gravity on the beams' own weight (0: tip force only; 9.81 adds the weight)"
    },
    {
      "name": "Pi",
      "value": "3.141592653589793",
      "unit": null,
      "description": "pi (a global expression cannot use the built-in constant)"
    },
    {
      "name": "h",
      "value": "0.1",
      "unit": "m",
      "description": "IPE 100: height"
    },
    {
      "name": "b",
      "value": "0.055",
      "unit": "m",
      "description": "IPE 100: flange width"
    },
    {
      "name": "tw",
      "value": "0.0041",
      "unit": "m",
      "description": "IPE 100: web thickness"
    },
    {
      "name": "tf",
      "value": "0.0057",
      "unit": "m",
      "description": "IPE 100: flange thickness"
    },
    {
      "name": "A_ipe",
      "value": "2*b*tf + (h - 2*tf)*tw",
      "unit": "m^2",
      "description": "I-beam area (no root fillets)"
    },
    {
      "name": "I_ipe",
      "value": "(b*h^3 - (b - tw)*(h - 2*tf)^3)/12",
      "unit": "m^4",
      "description": "I-beam second moment, strong axis"
    },
    {
      "name": "d_rod",
      "value": "sqrt(4*A_ipe/Pi)",
      "unit": "m",
      "description": "Round bar diameter: the I-beam's area"
    },
    {
      "name": "A_rod",
      "value": "Pi*d_rod^2/4",
      "unit": "m^2",
      "description": "Round bar area"
    },
    {
      "name": "I_rod",
      "value": "Pi*d_rod^4/64",
      "unit": "m^4",
      "description": "Round bar second moment"
    },
    {
      "name": "a_sq",
      "value": "sqrt(A_ipe)",
      "unit": "m",
      "description": "Square bar side: the I-beam's area"
    },
    {
      "name": "A_sq",
      "value": "a_sq^2",
      "unit": "m^2",
      "description": "Square bar area"
    },
    {
      "name": "I_sq",
      "value": "a_sq^4/12",
      "unit": "m^4",
      "description": "Square bar second moment"
    }
  ],
