<?xml version="1.0"?>
<!--
  drivetrain-position: motor, 10:1 gearbox, wheel 1, a long thin compliant shaft and wheel 2 in a row
  along +X (Z-up, metres, every shaft turns about +X).

  Joint angles come from the model (rad):
    rotor_joint    motor rotor                       Theta/y
    wheel1_joint   wheel 1 behind the 10:1 gear       0.1 * Theta/y
    wheel2_joint   wheel 2                           ThetaL/y   (= wheel 1 + C/q)
  The shaft `shaft_rod` (0.705 m, from the face of wheel 1 at x = 0.27 to the face of wheel 2 at
  x = 0.975) belongs to the wheel1 link, so it turns with wheel 1, and a torsion deformation binding
  with the linear basis twists it by theta(s) = s / L * C/q (C/q is the downstream minus the upstream
  angle): the lumped spring's linear twist, so its far end sits at the wheel-2 angle. The wheels and
  the rotor carry markers and the rod's stripes show the twist of the 1.2 N m/rad shaft (drawn x10 by
  default, scene.exaggeration: 0.17 rad moves the stripes of the 8 mm shaft by only 1.4 mm).
-->
<sdf version="1.9">
  <model name="drivetrain_position">
    <link name="frame">
      <pose>0 0 0 0 0 0</pose>
      <visual name="base_plate">
        <pose>0.5 0 -0.11 0 0 0</pose>
        <geometry><box><size>1.4 0.22 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="motor_housing">
        <pose>-0.05 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="gearbox">
        <pose>0.13 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
        <material><diffuse>0.35 0.37 0.4 1</diffuse></material>
      </visual>
      <visual name="bearing_block">
        <pose>1.0 0 -0.06 0 0 0</pose>
        <geometry><box><size>0.03 0.1 0.09</size></box></geometry>
        <material><diffuse>0.35 0.37 0.4 1</diffuse></material>
      </visual>
    </link>
    <link name="rotor">
      <pose>0.015 0 0 0 0 0</pose>
      <visual name="rotor_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="rotor_marker">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.034 0.008 0.012</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel1">
      <pose>0.25 0 0 0 0 0</pose>
      <visual name="wheel1_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel1_marker">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><box><size>0.044 0.01 0.014</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="shaft_rod">
        <pose>0.3725 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.705</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel2">
      <pose>1.0 0 0 0 0 0</pose>
      <visual name="wheel2_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="wheel2_marker">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry><box><size>0.054 0.012 0.016</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_joint" type="continuous">
      <parent>frame</parent>
      <child>rotor</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="wheel1_joint" type="continuous">
      <parent>frame</parent>
      <child>wheel1</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="wheel2_joint" type="continuous">
      <parent>frame</parent>
      <child>wheel2</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
  </model>
</sdf>
