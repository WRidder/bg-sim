        <material><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="lip_1">
        <pose>0 -0.09 0.0415 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>
      <visual name="bellows_2">
        <pose>0 0.09 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.0128</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.25 0.27 0.32 0.35</diffuse></material>
      </visual>
      <visual name="ring1_2">
        <pose>0 0.09 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.01472</radius><length>0.004</length></cylinder></geometry>
        <material><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="ring2_2">
        <pose>0 0.09 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.01472</radius><length>0.004</length></cylinder></geometry>
        <material><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="lip_2">
        <pose>0 0.09 0.0415 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>
    </link>
    <link name="box_1">
      <pose>0 -0.09 0.02 0 0 0</pose>
      <visual name="box_body_1">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.04</size></box></geometry>
        <material><diffuse>0.36 0.47 0.62 1</diffuse></material>
      </visual>
      <visual name="box_top_1">
        <pose>0 0 0.0204 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.0008</size></box></geometry>
        <material><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
      <visual name="box_stripe_1">
        <pose>0.0604 0 0 0 0 0</pose>
        <geometry><box><size>0.0008 0.072 0.016</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>
    <link name="box_2">
      <pose>0 0.09 0.02 0 0 0</pose>
