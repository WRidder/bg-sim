      "name": "T_exc",
      "value": "1*max(0, 1 - abs(motion - 1)) + (T_ring + T_cz + 0.6)*max(0, 1 - abs(motion - 2)) + (6*T_p + 6*T_c + 0.3)*max(0, 1 - abs(motion - 3)) + (2*T_sw + T_h + 0.8 + N_sw/(fsc*f_sw))*max(0, 1 - abs(motion - 4)) + (T_cx + 0.6)*max(0, 1 - abs(motion - 5))",
