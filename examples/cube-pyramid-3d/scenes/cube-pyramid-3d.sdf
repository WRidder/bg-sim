<?xml version="1.0"?>
<!--
  cube-pyramid-3d (plan 9.10, X-MB5): a 0.2 m cube with four reaction wheels in a pyramid, on the
  ground plane z = 0.

  Z-up, metres, the world frame of the model. The cube and the wheels are bound by their world pose
  (qw, qx, qy, qz, x, y, z): link "cube" follows the pose of the cube (Pose/g[1..7] in the contact
  models, PoseCube/g[1..7] in edge-switched) and link "wheel_k" follows PoseW<k>/g[1..7]. The wheel
  frame has its z axis along the spin axis, so the disc (a cylinder, whose axis is z) spins in
  place; a marker on its rim shows the rotation. The red sphere marks vertex 1 (-, -, -) of the
  cube, the corner it ends up balanced on. The link poses below are those of sequence-contact at
  the start (the cube lies flat, sunk about 0.3 mm into the compliant ground).
  The wheel discs are drawn with a 0.045 m radius so that they fit inside the cube; the real
  0.25 kg wheel with J = 0.002 kg m^2 would be 0.126 m wide.
-->
<sdf version="1.9">
  <model name="cube_pyramid_3d">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground_slab">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.8 0.8 0.02</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>

    <link name="cube">
      <pose>0 0 0.099691 0 0 0</pose>
      <visual name="cube_body">
        <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 0.35</diffuse></material>
      </visual>
      <visual name="corner_marker">
        <pose>-0.1 -0.1 -0.1 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_1">
      <pose>0.06 0 0.099691 0 0.955317 0</pose>
      <visual name="wheel_1_disc">
        <geometry><cylinder><radius>0.045</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_1_marker">
        <pose>0.03 0 0.01 0 0 0</pose>
        <geometry><box><size>0.03 0.01 0.006</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_2">
      <pose>0 0.06 0.099691 0 0.955317 1.570796</pose>
      <visual name="wheel_2_disc">
        <geometry><cylinder><radius>0.045</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="wheel_2_marker">
        <pose>0.03 0 0.01 0 0 0</pose>
        <geometry><box><size>0.03 0.01 0.006</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_3">
      <pose>-0.06 0 0.099691 0 0.955317 3.141593</pose>
      <visual name="wheel_3_disc">
        <geometry><cylinder><radius>0.045</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.9 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="wheel_3_marker">
        <pose>0.03 0 0.01 0 0 0</pose>
        <geometry><box><size>0.03 0.01 0.006</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_4">
      <pose>0 -0.06 0.099691 0 0.955317 -1.570796</pose>
      <visual name="wheel_4_disc">
        <geometry><cylinder><radius>0.045</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.6 0.45 0.85 1</diffuse></material>
      </visual>
      <visual name="wheel_4_marker">
        <pose>0.03 0 0.01 0 0 0</pose>
        <geometry><box><size>0.03 0.01 0.006</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
