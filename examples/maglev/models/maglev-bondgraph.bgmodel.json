        "Grav/p.e"
      ]
    }
  ],
  "scene": {
    "file": "scenes/maglev.sdf"
  },
  "bindings": [
    {
      "target": "joint:gap",
      "property": "position",
      "signal": "BallPos/y"
    },
    {
      "target": "joint:setpoint",
      "property": "position",
      "signal": "Ref/y"
    },
    {
      "target": "visual:coil_winding",
      "property": "color",
      "signal": "EM/i",
      "colormap": "heat",
      "range": [
        0.0,
        30.0
      ]
    }
  ],
  "parameters": [
    {
      "name": "m_b",
      "value": "0.02",
      "unit": "kg",
      "description": "Ball mass (MathWorks maglev)"
    },
    {
      "name": "g0",
      "value": "9.81",
      "unit": "m/s^2",
      "description": "Gravitational acceleration"
    },
    {
      "name": "alpha",
      "value": "2.4832e-5",
      "unit": "H*m",
      "description": "Force constant: F = alpha*i^2/h^2 (N*m^2/A^2)"
    },
    {
      "name": "c_trim",
      "value": "sqrt(m_b*g0/alpha)",
      "unit": "A/m",
      "description": "Trim law i_bar = c_trim*h_bar: alpha*i_bar^2/h_bar^2 = m_b*g0"
    },
    {
      "name": "h_start",
      "value": "0.15",
      "unit": "m",
      "description": "Gap at the start (levitating at rest)"
    },
    {
      "name": "h_step",
      "value": "0.1875",
      "unit": "m",
      "description": "Setpoint after the step (+25 %)"
    },
    {
      "name": "t_step",
      "value": "0.2",
      "unit": "s",
      "description": "Time of the setpoint step"
    },
    {
      "name": "tau_pre",
      "value": "0.1",
      "unit": "s",
      "description": "Reference prefilter 1/(tau_pre*s + 1), the reference's 10/(s + 10)"
    },
    {
      "name": "Tf",
      "value": "0.005",
      "unit": "s",
      "description": "Derivative filter of the PID: 5 ms for the sampled, noisy IR signal"
    },
    {
      "name": "L_inf",
      "value": "0.03",
      "unit": "H",
      "description": "Coil inductance at an infinite gap (assumed)"
    },
    {
      "name": "R_coil",
      "value": "2.0",
      "unit": "Ohm",
      "description": "Coil resistance (assumed)"
    },
    {
      "name": "V_max",
      "value": "60.0",
      "unit": "V",
      "description": "Amplifier rail"
    },
    {
      "name": "w_i",
      "value": "1000.0",
      "unit": "rad/s",
      "description": "Current-loop bandwidth"
    },
    {
      "name": "L0",
      "value": "L_inf + 2*alpha/h_start",
      "unit": "H",
      "description": "Coil inductance at the start gap"
    },
    {
      "name": "Kp_i",
      "value": "L0*w_i",
      "unit": "V/A",
      "description": "Current PI gain: the loop crosses over at w_i"
    },
    {
      "name": "Ti_i",
      "value": "L0/R_coil",
      "unit": "s",
      "description": "Current PI integral time: the PI zero cancels the coil pole"
    },
    {
      "name": "i_start",
      "value": "c_trim*h_start",
      "unit": "A",
      "description": "Trim current at the start gap"
    },
    {
      "name": "k_s",
      "value": "30.0",
      "unit": "V/m",
      "description": "IR sensor gain"
    }
  ],
