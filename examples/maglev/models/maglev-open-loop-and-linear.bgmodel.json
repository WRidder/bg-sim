      "name": "m_b",
      "value": "0.02",
      "unit": "kg",
      "description": "Ball mass (MathWorks maglev)"
    },
    {
      "name": "g0",
      "value": "9.81",
      "unit": "m/s^2",
      "description": "Gravitational acceleration"
    },
    {
      "name": "alpha",
      "value": "2.4832e-5",
      "unit": "H*m",
      "description": "Force constant: F = alpha*i^2/h^2 (N*m^2/A^2)"
    },
    {
      "name": "c_trim",
      "value": "sqrt(m_b*g0/alpha)",
      "unit": "A/m",
