{
  "project": "maglev",
  "description": "Maglev showcase (after the MathWorks 'maglev LPV model from batch linearization' example). Numbers come from design/design.json, an independent scipy calculation.",
  "models": {
    "maglev-current-driven": {
      "checks": [
        {
          "kind": "scene_bindings"
        },
        {
          "kind": "no_diagnostics",
          "codes": [
            "W201",
            "W202",
            "E106",
            "W206"
          ],
          "note": "integral causality everywhere, no algebraic loop, no event storm"
        },
        {
          "kind": "step_response",
          "signal": "Ball/h",
          "from_t": 0.2,
          "to_t": 1.4,
          "step_t": 0.2,
          "value": 0.1875,
          "initial": 0.15,
          "max_rise_time": 0.18,
          "max_overshoot": 0.005,
          "max_settling_time": 0.45,
          "note": "the MathWorks scenario 0.15 -> 0.1875 m (scipy design: rise 0.1671 s, overshoot 0.00%, settling 0.4086 s)"
        },
        {
          "kind": "cursor_value",
          "signal": "Ball/h",
          "t": 1.4,
          "value": 0.18749899410781165,
          "abs": 1e-08,
          "note": "the gap at 1.4 s equals the scipy simulation of the same loop"
        },
        {
          "kind": "max_abs",
          "signal": "PID/u",
          "value": 18.409863305820725,
          "rtol": 0.0001,
          "note": "peak coil current (scipy)"
        },
        {
          "kind": "min_ge",
          "signal": "PID/u",
          "value": 0.5912074568960541,
          "note": "the current stays positive (scipy minimum 1.1824 A): the magnet only pulls"
        },
        {
          "kind": "min_ge",
          "signal": "Ball/h",
          "value": 0.149999999,
          "note": "no undershoot below the start gap"
        },
        {
          "kind": "max_abs_le",
          "signal": "Ball/F_c",
          "value": 0.0,
          "note": "the ball never touches the magnet or the pedestal: it stays levitated"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/PID05/u",
          "t": 1.4,
          "value": 4.444405292281731,
          "rtol": 1e-06,
          "note": "integral action finds the trim current sqrt(m g/alpha)*0.05 m"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/Ball05/h",
          "t": 1.4,
          "value": 0.05,
          "rtol": 1e-06,
          "note": "and holds the gap"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/PID15/u",
          "t": 1.4,
          "value": 13.333215876845191,
          "rtol": 1e-06,
          "note": "integral action finds the trim current sqrt(m g/alpha)*0.15 m"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/Ball15/h",
          "t": 1.4,
          "value": 0.15,
          "rtol": 1e-06,
          "note": "and holds the gap"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/PID25/u",
          "t": 1.4,
          "value": 22.222026461408653,
          "rtol": 1e-06,
          "note": "integral action finds the trim current sqrt(m g/alpha)*0.25 m"
        },
        {
          "kind": "cursor_value",
          "signal": "Statics/Ball25/h",
          "t": 1.4,
          "value": 0.25,
          "rtol": 1e-06,
          "note": "and holds the gap"
        }
      ]
    },
