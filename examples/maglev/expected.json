    "maglev-bondgraph": {
      "checks": [
        {
          "kind": "scene_bindings"
        },
        {
          "kind": "no_diagnostics",
          "codes": [
            "W201",
            "W202",
            "E106",
            "W206"
          ],
          "note": "integral causality everywhere, no algebraic loop, no event storm"
        },
        {
          "kind": "step_response",
          "signal": "BallPos/y",
          "from_t": 0.2,
          "to_t": 1.4,
          "step_t": 0.2,
          "value": 0.1875,
          "initial": 0.15,
          "max_rise_time": 0.18,
          "max_overshoot": 0.01,
          "max_settling_time": 0.35,
          "note": "cascade with the noisy, sampled IR sensor; the scipy design is continuous and noise-free (scipy design: rise 0.1650 s, overshoot 0.14%, settling 0.2867 s)"
        },
        {
          "kind": "invariant",
          "terms": [
            {
              "signal": "EM/W",
              "coeff": 1.0
            },
            {
              "signal": "Eel/y",
              "coeff": -1.0
            },
            {
              "signal": "Emech/y",
              "coeff": -1.0
            }
          ],
          "tol": 1e-07,
          "scale": 2.6960496842783503,
          "note": "the IC-field stores exactly what flows in: W(t) - integral(v i) - integral(F dh/dt) = W(0)"
        },
        {
          "kind": "cursor_value",
          "signal": "EM/W",
          "t": 0.0,
          "value": 2.6960496842783503,
          "rtol": 1e-09,
          "note": "W(0) = L(h0) i0^2 / 2"
        },
        {
          "kind": "max_abs_le",
          "signal": "Sat/y",
          "value": 60.0,
          "note": "the amplifier rail"
        },
        {
          "kind": "min_ge",
          "signal": "EM/i",
          "value": 1.0,
          "note": "the coil current stays positive"
        },
        {
          "kind": "compare_signals",
          "signal": "EM/h",
          "signal_b": "BallPos/y",
          "max_abs": 1e-09,
          "note": "the field's gap state and the ball position sensor integrate the same velocity"
        },
        {
          "kind": "compare_signals",
          "signal": "EM/F",
          "signal_b": "Fmag/y",
          "max_abs": 1e-12,
          "note": "the effort detector on the 0-junction reads the field force"
        }
      ]
    },
    "maglev-bondgraph-ideal-sensor": {
      "model": "maglev-bondgraph",
      "settings": {
        "t_end": 6.0,
        "output": {
          "points": 12001
        }
      },
      "overrides": [
        {
          "target": "IR/Noise/std",
          "value": 0.0
        },
        {
          "target": "IR/ADC/bits",
          "value": 52
        }
      ],
      "checks": [
        {
          "kind": "no_diagnostics",
          "codes": [
            "W201",
            "W202",
            "E106",
            "W206"
          ],
          "note": "integral causality everywhere, no algebraic loop, no event storm"
        },
        {
          "kind": "cursor_value",
          "signal": "EM/W",
          "t": 0.0,
          "value": 2.6960496842783503,
          "rtol": 1e-09
        },
        {
          "kind": "ratio",
          "signal": "EM/i",
          "signal_b": "EM/h",
          "t": 6.0,
          "value": 88.88810584563461,
          "rtol": 1e-06,
          "note": "the same statics as maglev-current-driven: i = sqrt(m g/alpha) h at rest"
        },
        {
          "kind": "final_value",
          "signal": "EM/F",
          "t": 6.0,
          "value": 0.1962,
          "rtol": 1e-06,
          "note": "the field carries the weight"
        },
        {
          "kind": "final_value",
          "signal": "BallPos/y",
          "t": 6.0,
          "value": 0.1875,
          "rtol": 1e-06
        },
        {
          "kind": "cursor_value",
          "signal": "BallPos/y",
          "t": 1.4,
          "value": 0.18747798239183044,
          "abs": 2e-06,
          "note": "the slow integral tail at 1.4 s (scipy, continuous)"
        },
        {
          "kind": "step_response",
          "signal": "BallPos/y",
          "from_t": 0.2,
          "to_t": 1.4,
          "step_t": 0.2,
          "value": 0.1875,
          "initial": 0.15,
          "max_rise_time": 0.18,
          "max_overshoot": 0.005,
          "max_settling_time": 0.32,
          "note": "ideal sensor (sampled at 1 kHz, no noise, 52-bit ADC) (scipy design: rise 0.1650 s, overshoot 0.14%, settling 0.2867 s)"
        },
        {
          "kind": "max_abs_le",
          "signal": "Sat/y",
          "value": 60.0
        }
      ]
    }
  },
  "compare": [
    {
      "a": "maglev-current-driven",
      "b": "maglev-bondgraph-ideal-sensor",
      "signal_a": "Ball/h",
      "signal_b": "BallPos/y",
      "from_t": 0.0,
      "max_abs": 0.003,
      "note": "the cascade (other PID, 1 kHz sensor, coil dynamics) tracks the current-driven loop within 3 mm (8 % of the step)"
    }
  ]
}
