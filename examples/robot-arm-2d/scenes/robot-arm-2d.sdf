<?xml version="1.0"?>
<!--
  robot-arm-2d (plan 9.10, X-MB2): the planar two-link arm in the vertical X-Z plane.

  The model is planar in its x-y plane with gravity along -y. The scene uses the SDF X-Z plane:
  model x is SDF x, model y is SDF z, and the model's counter-clockwise joint angles are rotations
  about -Y (rotating +X towards +Z). The shoulder is the world origin; at q1 = q2 = 0 the arm is
  stretched along +X. Link 1 is 0.4 m long (centre of mass 0.2 m, the elbow 0.2 m behind it in the
  CoM frame). Link 2 carries the end effector 0.3 m from the elbow (the model's TipOffset); its
  centre of mass is 0.2 m from the elbow (a sphere marks it, with the payload at the tip).
  Joint "shoulder" is bound to the angle q1 and joint "elbow" to the relative angle q2, in rad.
-->
<sdf version="1.9">
  <model name="robot_arm_2d">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="base_pedestal">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.2</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="base_floor">
        <pose>0 0 -0.21 0 0 0</pose>
        <geometry><box><size>0.5 0.25 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>

    <link name="link1">
      <pose>0 0 0 0 0 0</pose>
      <visual name="link1_bar">
        <pose>0.2 0 0 0 0 0</pose>
        <geometry><box><size>0.4 0.05 0.05</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="shoulder_hub">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="link2">
      <pose>0.4 0 0 0 0 0</pose>
      <visual name="link2_bar">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.04 0.04</size></box></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="elbow_hub">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="payload">
        <pose>0.3 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="shoulder" type="revolute">
      <parent>base</parent>
      <child>link1</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="elbow" type="revolute">
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
