<?xml version="1.0"?>
<!--
  gripper: a parallel-jaw gripper on a pick-and-place carriage, moving a part (a 50 mm steel ball) from the
  source (y = 0) to the target (y = 0.4 m). Generated by design/build_model.py from design/design.py.

  Z-up, metres. The table top is z = 0. Link "gripper" is the carriage: its origin is the gripping
  point between the jaw faces, its pose is bound to Carriage/pose (it only translates). The jaws
  "jaw_a" (at +x, closing towards -x) and "jaw_b" (at -x, closing towards +x) are children of the
  gripper on the prismatic joints "slide_a"/"slide_b", bound to the jaw closing travel JawPos/y
  (0 = open). The jaw pads
  "pad_a"/"pad_b" are coloured by the friction utilisation |F_t|/(mu f_n) (blue: far from slipping,
  red: sliding); the status light "led" by Grip/holds. Link "ball" is bound to the part pose.
-->
<sdf version="1.9">
  <model name="gripper">
    <link name="world_fixed">
      <pose>0 0 0 0 0 0</pose>
      <visual name="table_top">
        <pose>-0.03 0.2 -0.0125 0 0 0</pose>
        <geometry><box><size>0.46 0.76 0.025</size></box></geometry>
        <material><diffuse>0.66 0.68 0.7 1</diffuse></material>
      </visual>
      <visual name="table_frame">
        <pose>-0.03 0.2 -0.045 0 0 0</pose>
        <geometry><box><size>0.42 0.72 0.04</size></box></geometry>
        <material><diffuse>0.3 0.32 0.36 1</diffuse></material>
      </visual>
      <visual name="source_plate">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><box><size>0.11 0.11 0.002</size></box></geometry>
        <material><diffuse>0.2 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="source_ring">
        <pose>0 0 0.0013 0 0 0</pose>
        <geometry><cylinder><radius>0.031</radius><length>0.0025</length></cylinder></geometry>
        <material><diffuse>0.92 0.92 0.9 1</diffuse></material>
      </visual>
      <visual name="source_dot">
        <pose>0 0 0.0015 0 0 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.2 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="target_plate">
        <pose>0 0.4 0.001 0 0 0</pose>
        <geometry><box><size>0.11 0.11 0.002</size></box></geometry>
        <material><diffuse>0.2 0.68 0.4 1</diffuse></material>
      </visual>
      <visual name="target_ring">
        <pose>0 0.4 0.0013 0 0 0</pose>
        <geometry><cylinder><radius>0.031</radius><length>0.0025</length></cylinder></geometry>
        <material><diffuse>0.92 0.92 0.9 1</diffuse></material>
      </visual>
      <visual name="target_dot">
        <pose>0 0.4 0.0015 0 0 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.2 0.68 0.4 1</diffuse></material>
      </visual>
      <visual name="post_a">
        <pose>-0.2 -0.16 0.16249 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.40499</size></box></geometry>
        <material><diffuse>0.5 0.53 0.58 1</diffuse></material>
      </visual>
      <visual name="post_b">
        <pose>-0.2 0.56 0.16249 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.40499</size></box></geometry>
        <material><diffuse>0.5 0.53 0.58 1</diffuse></material>
      </visual>
      <visual name="beam">
        <pose>-0.18 0.2 0.36499 0 0 0</pose>
        <geometry><box><size>0.04 0.75 0.04</size></box></geometry>
        <material><diffuse>0.5 0.53 0.58 1</diffuse></material>
      </visual>
      <visual name="rail">
        <pose>-0.155 0.2 0.37299 0 0 0</pose>
        <geometry><box><size>0.01 0.72 0.012</size></box></geometry>
        <material><diffuse>0.85 0.6 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="gripper">
      <pose>0 0 0 0 0 0</pose>
      <visual name="slide">
        <pose>-0.11 0 0.26 0 0 0</pose>
        <geometry><box><size>0.07 0.07 0.03</size></box></geometry>
        <material><diffuse>0.3 0.32 0.36 1</diffuse></material>
      </visual>
      <visual name="z_column">
        <pose>-0.09 0 0.16 0 0 0</pose>
        <geometry><box><size>0.03 0.05 0.22</size></box></geometry>
        <material><diffuse>0.75 0.77 0.8 1</diffuse></material>
      </visual>
      <visual name="flange">
        <pose>0 0 0.124 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.62 0.64 0.67 1</diffuse></material>
      </visual>
      <visual name="flange_arm">
        <pose>-0.045 0 0.124 0 0 0</pose>
        <geometry><box><size>0.09 0.03 0.012</size></box></geometry>
        <material><diffuse>0.62 0.64 0.67 1</diffuse></material>
      </visual>
      <visual name="housing">
        <pose>0 0 0.083 0 0 0</pose>
        <geometry><box><size>0.15 0.056 0.07</size></box></geometry>
        <material><diffuse>0.2 0.33 0.55 1</diffuse></material>
      </visual>
      <visual name="housing_cap">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>0.152 0.058 0.008</size></box></geometry>
        <material><diffuse>0.14 0.15 0.17 1</diffuse></material>
      </visual>
      <visual name="motor_can">
        <pose>0 0 0.143 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.14 0.15 0.17 1</diffuse></material>
      </visual>
      <visual name="guide">
        <pose>0 0 0.042 0 0 0</pose>
        <geometry><box><size>0.15 0.03 0.012</size></box></geometry>
        <material><diffuse>0.78 0.8 0.84 1</diffuse></material>
      </visual>
      <visual name="label_strip">
        <pose>0 -0.0285 0.09 0 0 0</pose>
        <geometry><box><size>0.09 0.001 0.012</size></box></geometry>
        <material><diffuse>0.9 0.9 0.92 1</diffuse></material>
      </visual>
      <visual name="led">
        <pose>0.058 -0.029 0.1 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <material><diffuse>0.3 0.9 0.4 1</diffuse></material>
      </visual>
    </link>

    <link name="jaw_a">
      <pose>0 0 0 0 0 0</pose>
      <visual name="carriage_a">
        <pose>0.049 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.04 0.02</size></box></geometry>
        <material><diffuse>0.78 0.8 0.84 1</diffuse></material>
      </visual>
      <visual name="finger_a">
        <pose>0.044 0 0.006 0 0 0</pose>
        <geometry><box><size>0.012 0.016 0.05</size></box></geometry>
        <material><diffuse>0.7 0.72 0.75 1</diffuse></material>
      </visual>
      <visual name="pad_a">
        <pose>0.0345 0 0 0 0 0</pose>
        <geometry><box><size>0.007 0.024 0.024</size></box></geometry>
        <material><diffuse>0.2 0.4 0.85 1</diffuse></material>
      </visual>
    </link>

    <link name="jaw_b">
      <pose>0 0 0 0 0 0</pose>
      <visual name="carriage_b">
        <pose>-0.049 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.04 0.02</size></box></geometry>
        <material><diffuse>0.78 0.8 0.84 1</diffuse></material>
      </visual>
      <visual name="finger_b">
        <pose>-0.044 0 0.006 0 0 0</pose>
        <geometry><box><size>0.012 0.016 0.05</size></box></geometry>
        <material><diffuse>0.7 0.72 0.75 1</diffuse></material>
      </visual>
      <visual name="pad_b">
        <pose>-0.0345 0 0 0 0 0</pose>
        <geometry><box><size>0.007 0.024 0.024</size></box></geometry>
        <material><diffuse>0.2 0.4 0.85 1</diffuse></material>
      </visual>
    </link>

    <link name="ball">
      <pose>0 0 0 0 0 0</pose>
      <visual name="sphere">
        <pose>0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><diffuse>0.82 0.84 0.88 1</diffuse></material>
      </visual>
      <visual name="mark">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.02505</radius><length>0.002</length></cylinder></geometry>
        <material><diffuse>0.35 0.37 0.4 1</diffuse></material>
      </visual>
    </link>

    <joint name="slide_a" type="prismatic">
      <parent>gripper</parent>
      <child>jaw_a</child>
      <axis><xyz>-1 0 0</xyz></axis>
    </joint>

    <joint name="slide_b" type="prismatic">
      <parent>gripper</parent>
      <child>jaw_b</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
  </model>
</sdf>
