<?xml version="1.0"?>
<!--
  rlc-dual (plan 9.3): two gauge columns, one per subsystem, that follow the capacitor voltage.

  Z-up, metres. The left column belongs to the iconic circuit (Iconic/C1/v), the right one to the
  bond graph (Bondgraph/C1/p.e). Each box is 0.2 m high at 1 V and its scale.z follows the
  voltage; the box scales about its centre (z = 0.12 m), so a column of 1.16 V (the step
  overshoot) just touches the plate. The colour follows the same voltage (heat, 0 to 1.2 V).
  The two columns must move together: the circuits are the same.
-->
<sdf version="1.9">
  <model name="rlc_dual">
    <link name="plate">
      <pose>0 0 0 0 0 0</pose>
      <visual name="plate_slab">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.4 0.2 0.02</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
      <visual name="level_mark">
        <pose>0 -0.07 0.22 0 0 0</pose>
        <geometry><box><size>0.36 0.004 0.004</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="columns">
      <pose>0 0 0 0 0 0</pose>
      <visual name="iconic_bar">
        <pose>-0.1 0 0.12 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.2</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="bondgraph_bar">
        <pose>0.1 0 0.12 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.2</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
    </link>

    <joint name="fix_columns" type="fixed">
      <parent>plate</parent>
      <child>columns</child>
    </joint>
  </model>
</sdf>
