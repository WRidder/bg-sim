<?xml version="1.0"?>
<!--
  dc-motor (plan 9.1): a motor housing with the rotor disc on the shaft.

  Z-up, metres. The shaft axis is +Z, the rotor turns about it (joint "shaft"). The rotor angle is
  the model's Motor1/rotor/phi in rad (iconic and speed-control); the bond-graph model has no
  angle signal, so there the rotor disc is coloured by the rotor speed (IJ/p.f) instead.
-->
<sdf version="1.9">
  <model name="dc_motor">
    <link name="housing">
      <pose>0 0 0 0 0 0</pose>
      <visual name="housing_body">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="base_plate">
        <pose>0 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.14 0.1 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="shaft_stub">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor">
      <pose>0 0 0.035 0 0 0</pose>
      <visual name="rotor_disc">
        <geometry><cylinder><radius>0.025</radius><length>0.01</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="rotor_stripe">
        <pose>0.015 0 0.0075 0 0 0</pose>
        <geometry><box><size>0.022 0.006 0.005</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>

    <joint name="shaft" type="continuous">
      <parent>housing</parent>
      <child>rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
  </model>
</sdf>
