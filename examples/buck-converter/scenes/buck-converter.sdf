<?xml version="1.0"?>
<!--
  buck-converter: a small synchronous buck board.  The two bars on the right show the
  output voltage (Vout/y, 0..5 V) and the inductor current (IL/y, 0..2.5 A); the colours
  are bound in the model.  Z-up, metres.  The board is static: this is a controller
  example, so the scene is a read-out, not a mechanism.
-->
<sdf version="1.9">
  <model name="buck_converter">
    <link name="board">
      <pose>0 0 0 0 0 0</pose>

      <visual name="pcb">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>0.30 0.20 0.01</size></box></geometry>
        <material><diffuse>0.10 0.35 0.20 1</diffuse></material>
      </visual>

      <visual name="input_connector">
        <pose>-0.13 0 0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material>
      </visual>

      <visual name="inductor">
        <pose>-0.05 0.04 0.028 0 0 0</pose>
        <geometry><box><size>0.06 0.035 0.03</size></box></geometry>
        <material><diffuse>0.45 0.30 0.12 1</diffuse></material>
      </visual>

      <visual name="capacitor">
        <pose>0.01 0.04 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.15 0.25 0.60 1</diffuse></material>
      </visual>

      <visual name="controller">
        <pose>-0.01 -0.04 0.017 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.012</size></box></geometry>
        <material><diffuse>0.08 0.08 0.10 1</diffuse></material>
      </visual>

      <visual name="vout_bar">
        <pose>0.12 0.055 0.06 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
        <material><diffuse>0.25 0.50 0.85 1</diffuse></material>
      </visual>

      <visual name="il_bar">
        <pose>0.12 -0.055 0.06 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
        <material><diffuse>0.85 0.50 0.20 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
