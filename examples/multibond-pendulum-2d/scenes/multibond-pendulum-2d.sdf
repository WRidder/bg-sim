<?xml version="1.0"?>
<!--
  multibond-pendulum-2d (plan 9.3, X-MB1): the rigid pendulum of the Gate A model.

  The model is planar in its x-y plane with gravity along -y. The scene uses the vertical X-Z
  plane of SDF: model x is SDF x, model y is SDF z, and the model's counter-clockwise angle is a
  rotation about -Y (rotating +X towards +Z). The pivot is the world origin; at q = 0 the pendulum
  hangs straight down and its centre of mass is 0.5 m below the pivot (the model's CoM offset).
  Joint "pivot" is bound to the model's joint angle Joint/qout in rad.
  The bob is the centre of mass (m = 1 kg, J = 1e-4 kg m^2: a point-like bob).
-->
<sdf version="1.9">
  <model name="multibond_pendulum_2d">
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="support_beam">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.3 0.08 0.02</size></box></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="pivot_pin">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <link name="rod">
      <pose>0 0 0 0 0 0</pose>
      <visual name="rod_bar">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="bob">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="pivot" type="revolute">
      <parent>mount</parent>
      <child>rod</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
