<?xml version="1.0"?>
<!--
  drivetrain (plan 9.5): motor, gearbox and a flexible rod between two inertias, in a row along +X.

  Z-up, metres. Every shaft turns about +X. The motor rotor (rotor_joint) is bound to
  Motor1/rotor/phi, the first wheel (wheel1_joint, after the 10:1 gear) to Wheel1/phi and the
  load wheel (wheel2_joint, behind the flexible rod) to Wheel2/phi, all in rad. The twist of the
  rod is the angle between the two markers. The bond-graph model has speeds only, so there the
  three discs are coloured by speed instead.
-->
<sdf version="1.9">
  <model name="drivetrain">
    <link name="frame">
      <pose>0 0 0 0 0 0</pose>
      <visual name="base_plate">
        <pose>0.3 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.8 0.2 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="motor_housing">
        <pose>-0.05 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="gearbox">
        <pose>0.13 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
        <material><diffuse>0.35 0.37 0.4 1</diffuse></material>
      </visual>
      <visual name="rod">
        <pose>0.45 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.3</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor">
      <pose>0.015 0 0 0 0 0</pose>
      <visual name="rotor_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="rotor_marker">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.034 0.008 0.012</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel1">
      <pose>0.25 0 0 0 0 0</pose>
      <visual name="wheel1_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel1_marker">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><box><size>0.044 0.01 0.014</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel2">
      <pose>0.6 0 0 0 0 0</pose>
      <visual name="wheel2_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="wheel2_marker">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry><box><size>0.054 0.012 0.016</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_joint" type="continuous">
      <parent>frame</parent>
      <child>rotor</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="wheel1_joint" type="continuous">
      <parent>frame</parent>
      <child>wheel1</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="wheel2_joint" type="continuous">
      <parent>frame</parent>
      <child>wheel2</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
  </model>
</sdf>
