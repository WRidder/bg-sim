<?xml version="1.0"?>
<!--
  hydraulic-servo (plan 9.6): a single-rod hydraulic cylinder moving a 50 kg mass along +X.

  Z-up, metres. The barrel is drawn translucent, from x = 0 to 0.24 m; the piston starts 0.02 m
  inside its cap end and the stroke is 0.2 m (the model's Cyl stroke). Joint "stroke" (prismatic,
  +X) is bound to the rod position XS/y in m, so the piston, rod and mass move together. The
  tick at x = 0.46 m marks the load centre after the 0.1 m reference step (at rest it is at 0.36 m).
-->
<sdf version="1.9">
  <model name="hydraulic_servo">
    <link name="barrel">
      <pose>0 0 0 0 0 0</pose>
      <visual name="barrel_tube">
        <pose>0.12 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.24</length></cylinder></geometry>
        <material><diffuse>0.55 0.57 0.6 0.35</diffuse></material>
      </visual>
      <visual name="cap_end">
        <pose>-0.01 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="rod_end_gland">
        <pose>0.25 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="base_plate">
        <pose>0.3 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.7 0.2 0.02</size></box></geometry>
        <material><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>
      <visual name="reference_tick">
        <pose>0.46 0 -0.075 0 0 0</pose>
        <geometry><box><size>0.006 0.1 0.01</size></box></geometry>
        <material><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="piston">
      <pose>0.02 0 0 0 0 0</pose>
      <visual name="piston_disc">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.058</radius><length>0.02</length></cylinder></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="piston_rod">
        <pose>0.15 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material>
      </visual>
      <visual name="load_mass">
        <pose>0.34 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.12 0.1</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
    </link>

    <joint name="stroke" type="prismatic">
      <parent>barrel</parent>
      <child>piston</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
