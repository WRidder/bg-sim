<?xml version="1.0"?>
<!--
  Planar Links: the 1-, 2- and 3-link arms side by side.
  The model is planar in its x-y plane with gravity along -y; the scene uses the SDF X-Z
  plane (model x is SDF x, model y is SDF z). Counter-clockwise joint angles are rotations
  about -Y. Each joint is bound to the relative angle of its joint (qout, rad); the scene
  pose is the stretched arm (all angles 0), the model starts with joint 1 at -pi/2.
-->
<sdf version="1.9">
  <model name="planar_links">
    <link name="a1_base">
      <pose>0.0 0 0 0 0 0</pose>
      <visual name="a1_pedestal">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.24</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="a1_floor">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><box><size>0.9 0.4 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>
    <link name="a1_link1">
      <pose>0.0 0 0 0 0 0</pose>
      <visual name="a1_bar1">
        <pose>0.3375 0 0 0 0 0</pose>
        <geometry><box><size>0.675 0.05 0.05</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="a1_hub1">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a1_com1">
        <pose>0.38400000000000006 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="a2_base">
      <pose>2.0 0 0 0 0 0</pose>
      <visual name="a2_pedestal">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.24</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="a2_floor">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><box><size>0.9 0.4 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>
    <link name="a2_link1">
      <pose>2.0 0 0 0 0 0</pose>
      <visual name="a2_bar1">
        <pose>0.3375 0 0 0 0 0</pose>
        <geometry><box><size>0.675 0.05 0.05</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="a2_hub1">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a2_com1">
        <pose>0.38400000000000006 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="a2_link2">
      <pose>2.675 0 0 0 0 0</pose>
      <visual name="a2_bar2">
        <pose>0.2625 0 0 0 0 0</pose>
        <geometry><box><size>0.525 0.042 0.042</size></box></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="a2_hub2">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a2_com2">
        <pose>0.343 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="a3_base">
      <pose>4.2 0 0 0 0 0</pose>
      <visual name="a3_pedestal">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.24</length></cylinder></geometry>
        <material><diffuse>0.45 0.47 0.5 1</diffuse></material>
      </visual>
      <visual name="a3_floor">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><box><size>0.9 0.4 0.02</size></box></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
    </link>
    <link name="a3_link1">
      <pose>4.2 0 0 0 0 0</pose>
      <visual name="a3_bar1">
        <pose>0.3375 0 0 0 0 0</pose>
        <geometry><box><size>0.675 0.05 0.05</size></box></geometry>
        <material><diffuse>0.25 0.5 0.85 1</diffuse></material>
      </visual>
      <visual name="a3_hub1">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a3_com1">
        <pose>0.38400000000000006 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="a3_link2">
      <pose>4.875 0 0 0 0 0</pose>
      <visual name="a3_bar2">
        <pose>0.2625 0 0 0 0 0</pose>
        <geometry><box><size>0.525 0.042 0.042</size></box></geometry>
        <material><diffuse>0.35 0.7 0.45 1</diffuse></material>
      </visual>
      <visual name="a3_hub2">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a3_com2">
        <pose>0.343 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="a3_link3">
      <pose>5.4 0 0 0 0 0</pose>
      <visual name="a3_bar3">
        <pose>0.185 0 0 0 0 0</pose>
        <geometry><box><size>0.37 0.034 0.034</size></box></geometry>
        <material><diffuse>0.85 0.45 0.25 1</diffuse></material>
      </visual>
      <visual name="a3_hub3">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="a3_com3">
        <pose>0.010000000000000009 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><diffuse>0.95 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="a1_joint1" type="revolute">
      <parent>a1_base</parent>
      <child>a1_link1</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="a2_joint1" type="revolute">
      <parent>a2_base</parent>
      <child>a2_link1</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="a2_joint2" type="revolute">
      <parent>a2_link1</parent>
      <child>a2_link2</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="a3_joint1" type="revolute">
      <parent>a3_base</parent>
      <child>a3_link1</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="a3_joint2" type="revolute">
      <parent>a3_link1</parent>
      <child>a3_link2</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
    <joint name="a3_joint3" type="revolute">
      <parent>a3_link2</parent>
      <child>a3_link3</child>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
