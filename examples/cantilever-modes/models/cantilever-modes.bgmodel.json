  "parameters": [
    {
      "name": "E",
      "value": "210000000000.0",
      "unit": "Pa",
      "description": "Young's modulus (steel)"
    },
    {
      "name": "rho",
      "value": "7850.0",
      "unit": "kg/m^3",
      "description": "Density"
    },
    {
      "name": "d",
      "value": "0.01",
      "unit": "m",
      "description": "Rod diameter"
    },
    {
      "name": "L",
      "value": "1.0",
      "unit": "m",
      "description": "Length"
    },
    {
      "name": "F0",
      "value": "1.0",
      "unit": "N",
      "description": "Tip force step"
    },
    {
      "name": "zeta",
      "value": "0.05",
      "unit": null,
      "description": "Modal damping ratio"
    },
    {
      "name": "lam1",
      "value": "1.87510407",
      "unit": null,
      "description": "First clamped-free eigenvalue lambda_1"
    },
    {
      "name": "lam2",
      "value": "4.69409113",
      "unit": null,
      "description": "Second clamped-free eigenvalue lambda_2"
    },
    {
      "name": "phiL",
      "value": "2",
      "unit": null,
      "description": "|phi_n(L)|: tip value of a normalised cantilever mode"
    },
    {
      "name": "Pi",
      "value": "3.141592653589793",
      "unit": null,
      "description": "pi (a global expression cannot use the built-in constant)"
    },
    {
      "name": "A",
      "value": "Pi*d^2/4",
      "unit": "m^2",
      "description": "Cross-section area"
    },
    {
      "name": "I",
      "value": "Pi*d^4/64",
      "unit": "m^4",
      "description": "Second moment of area"
    },
    {
      "name": "m",
      "value": "rho*A*L",
      "unit": "kg",
      "description": "Modal mass of every mode (= beam mass)"
    },
    {
      "name": "k1",
      "value": "lam1^4*E*I/L^3",
      "unit": "N/m",
      "description": "Modal stiffness, mode 1"
    },
    {
      "name": "k2",
      "value": "lam2^4*E*I/L^3",
      "unit": "N/m",
      "description": "Modal stiffness, mode 2"
    },
    {
      "name": "c1",
      "value": "2*zeta*sqrt(k1*m)",
      "unit": "N*s/m",
      "description": "Modal damping, mode 1"
    },
    {
      "name": "c2",
      "value": "2*zeta*sqrt(k2*m)",
      "unit": "N*s/m",
      "description": "Modal damping, mode 2"
    }
  ],
