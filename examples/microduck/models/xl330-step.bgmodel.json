        "Servo/Transmit/y",
        "Servo/Friction/tau_f"
      ]
    }
  ],
  "dashboard": {
    "autoRerun": true,
    "cards": [
      {
        "id": "d1",
        "kind": "text",
        "size": "2x1",
        "title": "XL330 on the bench",
        "options": {
          "markdown": true,
          "text": "One servo swings the 100 g test arm of microduck_rl to 1 rad and back. Change the P gain or the supply and compare the encoder with the goal. At kp 200 the current peaks just under the 1.75 A limit; raise kp_fw and it saturates."
        }
      },
      {
        "id": "d2",
        "kind": "slider",
        "size": "1x1",
        "title": "Position P gain (kp_fw)",
        "parameter": "global:kp_fw",
        "options": {
          "min": 50.0,
          "max": 800.0,
          "step": 10.0,
          "decimals": 0
        }
      },
      {
        "id": "d3",
