  "settings": {
    "t_start": 0.0,
    "t_end": 1.6,
    "solver": "Rodas5P",
    "reltol": 1e-07,
    "abstol": 1e-09,
    "max_step": null,
    "output": {
      "mode": "points",
      "points": 1601
    },
    "event_limit": 100000
  },
  "parameters": [
    {
      "name": "kp_fw",
      "value": "200.0",
      "unit": "1",
      "description": "XL330 Position P Gain register (robotd gain 200; standing 0.8x, limp 50)"
    },
    {
      "name": "i_limit",
      "value": "1.75",
      "unit": "A",
      "description": "Firmware current limit (BAM/training 1.75 A; impact-guard firmware on the robot 1.0 A)"
    },
    {
      "name": "t_latency",
      "value": "0.02",
      "unit": "s",
      "description": "Command latency, goal written to goal applied (a multiple of 5 ms)"
    },
    {
      "name": "v_bat",
      "value": "7.4",
      "unit": "V",
      "description": "Supply voltage (2S Li-ion: 8.2 V full, 7.4 V nominal, 6.6 V empty under load)"
    },
    {
      "name": "k_motor",
      "value": "0.36601349688984386",
      "unit": "N*m/A",
      "description": "Torque constant at the horn, also the back-EMF constant (BAM XL330 M6 fit)"
    },
    {
      "name": "r_motor",
      "value": "2.8113923539223227",
      "unit": "Ohm",
      "description": "Winding plus driver resistance (BAM XL330 M6 fit)"
    },
    {
      "name": "armature",
      "value": "0.0018077432831600838",
      "unit": "kg*m^2",
      "description": "Rotor and gears reflected to the horn (BAM XL330 M6 fit); the rotor inertia of XL330 is armature/288.4^2, the joint of XL330Rigid carries it as Ja"
    }
  ],
  "plots": [
    {
      "id": "p1",
      "title": "Goal and encoder angle",
