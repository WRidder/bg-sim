<?xml version="1.0"?>
<!--
  cessna-sim: the flyable Cessna 172P on its airfield.
  Generated by design/build_model.py. Z-up, metres; x north, y west. The view keeps the aircraft framed by moving
  the world instead of the camera (block C172View): the aircraft stays at the origin, lifted 4 m, and the airfield
  (link field: runway 36 from x = -30 m, 1200 m long, the taxiway and apron to the east) moves under it. The moving
  parts turn on revolute joints about their hinge lines (meshes from design/make_meshes.py): ailerons, flaps,
  elevator and rudder with the surface angles (gain -pi/180: positive JSBSim deflections are trailing edge down,
  and trailing edge left for the rudder; the right aileron moves the other way, gain +pi/180), the propeller with
  the crankshaft angle (shown at 1/25 of the real speed, which a display could not show), the nose wheel with
  the steering angle.
-->
<sdf version="1.9">
  <model name="cessna-sim">
    <link name="field">
      <pose>0 0 0 0 0 0</pose>
      <visual name="grass">
        <pose>570 0 -0.55 0 0 0</pose>
        <geometry><box><size>2800 1600 1</size></box></geometry>
        <material><diffuse>0.36 0.47 0.30 1</diffuse></material>
      </visual>
      <visual name="runway">
        <pose>570 0 -0.04 0 0 0</pose>
        <geometry><box><size>1200 30 0.1</size></box></geometry>
        <material><diffuse>0.30 0.30 0.32 1</diffuse></material>
      </visual>
      <visual name="centreline_0">
