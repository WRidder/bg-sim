        <geometry><cylinder><radius>0.015</radius><length>0.08</length></cylinder></geometry>
        <material><diffuse>0.24 0.28 0.33 1</diffuse></material>
      </visual>
      <visual name="torso_head">
        <pose>0 0 1.43 0 0 0</pose>
        <geometry><sphere><radius>0.075</radius></sphere></geometry>
        <material><diffuse>0.34 0.40 0.48 1</diffuse></material>
      </visual>
    </link>
    <link name="ghost_torso">
      <pose>0 -1 0 0 0 0</pose>
      <visual name="ghost_torso_pedestal">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.7</length></cylinder></geometry>
