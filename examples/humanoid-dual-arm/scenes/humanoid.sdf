<?xml version="1.0"?>
<!--
  humanoid-dual-arm: the humanoid torso with two stacked 7-DOF SRS arms (left, blue; right, orange)
  and the ideal SRS pair (green) 1 m to its right. Written by design/build_scene.py. Z-up, metres,
  the robot faces +X, its left arm on +Y. Link <arm>_link<i> is the child frame of joint i at rest
  (all joints zero); joint <arm>_joint<i> turns it about its own z by the bound joint angle.
-->
<sdf version="1.9">
  <model name="humanoid">
    <link name="floor">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor_slab">
        <pose>0.2 -0.5 -0.006 0 0 0</pose>
        <geometry><box><size>2 2.6 0.012</size></box></geometry>
        <material><diffuse>0.55 0.57 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="torso">
      <pose>0 0 0 0 0 0</pose>
      <visual name="torso_pedestal">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.7</length></cylinder></geometry>
        <material><diffuse>0.17 0.21 0.25 1</diffuse></material>
      </visual>
      <visual name="torso_body">
        <pose>0 0 0.99 0 0 0</pose>
        <geometry><box><size>0.18 0.3 0.58</size></box></geometry>
        <material><diffuse>0.24 0.28 0.33 1</diffuse></material>
      </visual>
      <visual name="torso_shoulders">
        <pose>0 0 1.25 1.57079633 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.4</length></cylinder></geometry>
        <material><diffuse>0.24 0.28 0.33 1</diffuse></material>
      </visual>
      <visual name="torso_neck">
