<?xml version="1.0"?>
<!--
  excavator: the front of a 20-t class hydraulic excavator (boom 5.70 m, arm 2.90 m,
  bucket 1.50 m) in the vertical X-Z plane, written by design/build_model.py.
  Model x is SDF X, model y is SDF Z (the boom foot pin is the origin, the soil surface is
  at Z = -1.95); the joints turn about -Y with the model's joint angles. The cylinders,
  the rocker and the H-link are bars between two moving points (segment bindings).
-->
<sdf version="1.9">
  <model name="excavator">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground">
        <pose>3 0 -2.05 0 0 0</pose>
