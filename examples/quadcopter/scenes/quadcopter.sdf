        <geometry><box><size>0.12445 0.006 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_1_link">
      <pose>0.1591 -0.1591 0.047 0 0 0</pose>
      <visual name="blade_1">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.254 0.018 0.003</size></box></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="tip_1">
        <pose>0.102 0 0 0 0 0</pose>
        <geometry><box><size>0.05 0.019 0.0035</size></box></geometry>
        <material><diffuse>1.0 0.5 0.05 1</diffuse></material>
      </visual>
      <visual name="hub_1">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.8 0.8 0.82 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_2_link">
      <pose>-0.1591 0.1591 0.047 0 0 0</pose>
      <visual name="blade_2">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.254 0.018 0.003</size></box></geometry>
