        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="foot_1">
        <pose>0.11 0.11 -0.077 0 0 0</pose>
        <geometry><sphere><radius>0.008</radius></sphere></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="brace_1">
        <pose>0.044 0.044 -0.02 0 0 0.7853982</pose>
        <geometry><box><size>0.12445 0.006 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="strut_2">
        <pose>-0.11 0.11 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.066</length></cylinder></geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="foot_2">
