    <joint name="rotor_1" type="continuous">
      <parent>body</parent>
      <child>rotor_1_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="rotor_2" type="continuous">
      <parent>body</parent>
      <child>rotor_2_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="rotor_3" type="continuous">
      <parent>body</parent>
      <child>rotor_3_link</child>
