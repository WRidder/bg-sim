<?xml version="1.0"?>
<!--
  quadcopter (X5.7): a 450 mm X quadcopter with four spinning rotors above a ground plane. Generated by
  design/build_model.py from the numbers of design/design.py.

  Z-up, metres. The link "body" is the airframe frame at the centre of mass (x forward, y left, z up); its
  pose is bound to the seven pose signals of the model. The four rotor links sit above the motors and turn
  about the body z axis (joints "rotor_1" .. "rotor_4", bound to the integrated rotor angles; the clockwise
  rotors 3 and 4 carry gain -1). The front of the airframe is marked by the red nose block; one blade tip of
  every rotor is orange so the rotation is visible. The pads on the ground mark the mission: take-off at the
  origin, then (2, 0), (2, 2) and back.
-->
<sdf version="1.9">
  <model name="quadcopter">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="floor">
        <pose>0.8 0.8 -0.01 0 0 0</pose>
        <geometry><box><size>8 8 0.02</size></box></geometry>
        <material><diffuse>0.62 0.64 0.66 1</diffuse></material>
      </visual>
      <visual name="pad_0">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <visual name="pad_1">
        <pose>2 0 0.003 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.9 0.75 0.2 1</diffuse></material>
      </visual>
      <visual name="pad_2">
        <pose>2 2 0.003 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.9 0.75 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <visual name="plate_bottom">
        <pose>0 0 -0.012 0 0 0</pose>
        <geometry><box><size>0.17 0.12 0.012</size></box></geometry>
        <material><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>
      <visual name="battery">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.13 0.045 0.032</size></box></geometry>
        <material><diffuse>0.25 0.3 0.7 1</diffuse></material>
      </visual>
      <visual name="plate_top">
        <pose>0 0 0.014 0 0 0</pose>
        <geometry><box><size>0.12 0.1 0.006</size></box></geometry>
        <material><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="electronics">
        <pose>-0.01 0 0.026 0 0 0</pose>
        <geometry><box><size>0.06 0.05 0.016</size></box></geometry>
        <material><diffuse>0.2 0.55 0.35 1</diffuse></material>
      </visual>
      <visual name="nose">
        <pose>0.105 0 0.012 0 0 0</pose>
        <geometry><box><size>0.035 0.03 0.014</size></box></geometry>
        <material><diffuse>0.9 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="arm_1">
        <pose>0.07955 -0.07955 0 0 0 -0.7853982</pose>
        <geometry><box><size>0.225 0.022 0.012</size></box></geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="motor_1">
        <pose>0.1591 -0.1591 0.016 0 0 0</pose>
        <geometry><cylinder><radius>0.0135</radius><length>0.032</length></cylinder></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
      <visual name="arm_2">
        <pose>-0.07955 0.07955 0 0 0 2.356194</pose>
