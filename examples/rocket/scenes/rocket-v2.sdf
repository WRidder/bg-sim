<?xml version="1.0"?>
<!--
  rocket-v2: the V-2 on a vertical launch. Generated by design/build_model.py.
  Z-up, metres. The view keeps the rocket at the origin and moves the world (block RocketView): the
  link "v2" turns with the vehicle attitude (its x axis is the rocket axis, nose at +x; the link origin
  is the vehicle centre of mass drawn at the tail), the link "ground" (field and launch table) falls
  away below. The plume visual stretches with the thrust (scale.z, 1 at 25 t).
-->
<sdf version="1.9">
  <model name="rocket-v2">
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="field">
        <pose>0 0 -3.5 0 0 0</pose>
        <geometry><box><size>300 300 1</size></box></geometry>
        <material><diffuse>0.36 0.45 0.33 1</diffuse></material>
      </visual>
      <visual name="pad">
        <pose>0 0 -1.5 0 0 0</pose>
        <geometry><box><size>0 0 3</size></box></geometry>
        <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="v2">
      <pose>0 0 0 0 0 0</pose>
      <visual name="tail">
        <pose>0.8 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.7425</radius><length>1.6</length></cylinder></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="body_low">
        <pose>3.8 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.825</radius><length>4.4</length></cylinder></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="body_band">
        <pose>6.6 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.83325</radius><length>1.2</length></cylinder></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="body_up">
        <pose>8.35 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.825</radius><length>2.3</length></cylinder></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="nose1">
        <pose>10.4 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.66</radius><length>1.8</length></cylinder></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="nose2">
        <pose>12.05 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.45375</radius><length>1.5</length></cylinder></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="nose3">
        <pose>13.4 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.231</radius><length>1.2</length></cylinder></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="fin1">
        <pose>1.5 1.3 0 0 0 0</pose>
        <geometry><box><size>3 0.08 1.8</size></box></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="fin2">
        <pose>1.5 7.9602e-17 1.3 1.570796 0 0</pose>
        <geometry><box><size>3 0.08 1.8</size></box></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="fin3">
        <pose>1.5 -1.3 1.592e-16 3.141593 0 0</pose>
        <geometry><box><size>3 0.08 1.8</size></box></geometry>
        <material><diffuse>0.93 0.93 0.92 1</diffuse></material>
      </visual>
      <visual name="fin4">
        <pose>1.5 -2.3881e-16 -1.3 4.712389 0 0</pose>
        <geometry><box><size>3 0.08 1.8</size></box></geometry>
        <material><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
      <visual name="nozzle">
        <pose>-0.3 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.37</radius><length>0.6</length></cylinder></geometry>
        <material><diffuse>0.55 0.56 0.58 1</diffuse></material>
      </visual>
      <visual name="plume">
        <pose>-7.6 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.45</radius><length>14</length></cylinder></geometry>
        <material><diffuse>1.0 0.55 0.1 0.85</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
