        <geometry><box><size>6.0000 3.5000 1.8500</size></box></geometry>
        <material><diffuse>0.92 0.93 0.95 1</diffuse></material>
      </visual>
      <visual name="nose_top_r">
        <pose>-9.9000 0 1.2750 0 0.2500 0</pose>
        <geometry><box><size>5.2000 3.3000 0.2500</size></box></geometry>
        <material><diffuse>0.88 0.90 0.93 1</diffuse></material>
      </visual>
      <visual name="glass_r">
        <pose>-11.9000 0 0.8750 0 0.5000 0</pose>
        <geometry><box><size>0.1500 2.8000 0.9000</size></box></geometry>
        <material><diffuse>0.10 0.14 0.22 1</diffuse></material>
      </visual>
      <visual name="windows_l">
        <pose>0 1.8550 0.6750 0 0 0</pose>
        <geometry><box><size>19.0000 0.0200 0.7000</size></box></geometry>
        <material><diffuse>0.12 0.17 0.28 1</diffuse></material>
      </visual>
      <visual name="stripe_l">
        <pose>0 1.8550 -0.1750 0 0 0</pose>
        <geometry><box><size>25.0000 0.0200 0.2500</size></box></geometry>
        <material><diffuse>0.10 0.35 0.65 1</diffuse></material>
      </visual>
      <visual name="skirt_l">
        <pose>0 2.1500 -1.7750 0 0 0</pose>
        <geometry><box><size>23.0000 0.5000 1.6500</size></box></geometry>
        <material><diffuse>0.60 0.64 0.70 1</diffuse></material>
      </visual>
      <visual name="arm_l">
        <pose>0 1.5000 -2.4500 0 0 0</pose>
        <geometry><box><size>23.0000 0.9000 0.3000</size></box></geometry>
        <material><diffuse>0.50 0.54 0.60 1</diffuse></material>
      </visual>
      <visual name="windows_r">
        <pose>0 -1.8550 0.6750 0 0 0</pose>
        <geometry><box><size>19.0000 0.0200 0.7000</size></box></geometry>
        <material><diffuse>0.12 0.17 0.28 1</diffuse></material>
      </visual>
      <visual name="stripe_r">
        <pose>0 -1.8550 -0.1750 0 0 0</pose>
        <geometry><box><size>25.0000 0.0200 0.2500</size></box></geometry>
        <material><diffuse>0.10 0.35 0.65 1</diffuse></material>
      </visual>
      <visual name="skirt_r">
        <pose>0 -2.1500 -1.7750 0 0 0</pose>
        <geometry><box><size>23.0000 0.5000 1.6500</size></box></geometry>
        <material><diffuse>0.60 0.64 0.70 1</diffuse></material>
      </visual>
      <visual name="arm_r">
        <pose>0 -1.5000 -2.4500 0 0 0</pose>
        <geometry><box><size>23.0000 0.9000 0.3000</size></box></geometry>
        <material><diffuse>0.50 0.54 0.60 1</diffuse></material>
      </visual>
    </link>
    <link name="bogie_f">
      <pose>9.5 0 3.9 0 0 0</pose>
      <visual name="pad_f_l">
        <pose>0 1.5000 -0.0600 0 0 0</pose>
        <geometry><box><size>5.0000 0.7000 0.1200</size></box></geometry>
        <material><diffuse>0.35 0.36 0.40 1</diffuse></material>
      </visual>
      <visual name="coil_f_l">
        <pose>0 1.5000 -0.1800 0 0 0</pose>
        <geometry><box><size>4.6000 0.8000 0.1200</size></box></geometry>
        <material><diffuse>0.78 0.45 0.20 1</diffuse></material>
      </visual>
      <visual name="pad_f_r">
        <pose>0 -1.5000 -0.0600 0 0 0</pose>
        <geometry><box><size>5.0000 0.7000 0.1200</size></box></geometry>
        <material><diffuse>0.35 0.36 0.40 1</diffuse></material>
      </visual>
      <visual name="coil_f_r">
        <pose>0 -1.5000 -0.1800 0 0 0</pose>
        <geometry><box><size>4.6000 0.8000 0.1200</size></box></geometry>
        <material><diffuse>0.78 0.45 0.20 1</diffuse></material>
      </visual>
    </link>
    <link name="bogie_r">
      <pose>-9.5 0 3.9 0 0 0</pose>
      <visual name="pad_r_l">
        <pose>0 1.5000 -0.0600 0 0 0</pose>
        <geometry><box><size>5.0000 0.7000 0.1200</size></box></geometry>
        <material><diffuse>0.35 0.36 0.40 1</diffuse></material>
      </visual>
      <visual name="coil_r_l">
        <pose>0 1.5000 -0.1800 0 0 0</pose>
        <geometry><box><size>4.6000 0.8000 0.1200</size></box></geometry>
        <material><diffuse>0.78 0.45 0.20 1</diffuse></material>
      </visual>
      <visual name="pad_r_r">
        <pose>0 -1.5000 -0.0600 0 0 0</pose>
        <geometry><box><size>5.0000 0.7000 0.1200</size></box></geometry>
        <material><diffuse>0.35 0.36 0.40 1</diffuse></material>
      </visual>
      <visual name="coil_r_r">
        <pose>0 -1.5000 -0.1800 0 0 0</pose>
        <geometry><box><size>4.6000 0.8000 0.1200</size></box></geometry>
        <material><diffuse>0.78 0.45 0.20 1</diffuse></material>
      </visual>
    </link>
    <joint name="scroll" type="prismatic">
      <parent>world</parent>
      <child>track</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <joint name="heave" type="prismatic">
      <parent>world</parent>
      <child>lift</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="pitch" type="revolute">
      <parent>lift</parent>
      <child>car</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="gap_f" type="prismatic">
      <parent>world</parent>
      <child>bogie_f</child>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
    <joint name="gap_r" type="prismatic">
      <parent>world</parent>
      <child>bogie_r</child>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
  </model>
</sdf>
