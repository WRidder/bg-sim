<?xml version="1.0"?>
<!--
  maglev-train: a Transrapid-style car on a T-shaped guideway (Z up, X forward, metres).
  The pillars (every span) scroll under the car with the joint "scroll" (position -s mod span), so the
  car stays near the origin. The joints "heave" and "pitch" and the pads' "gap_f" and "gap_r" are bound with
  a gain of 100: deviations from the nominal levitated state are exaggerated 100 times (the nominal
  gap of 10 mm itself stays true to scale). The copper coils are coloured by the coil current.
  Written by examples/maglev-train/design/build_model.py.
-->
<sdf version="1.9">
  <model name="maglev-train">
    <link name="world">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>136.2240 40.0000 0.1000</size></box></geometry>
        <material><diffuse>0.28 0.40 0.24 1</diffuse></material>
      </visual>
    </link>
    <link name="track">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pillar_0">
        <pose>-74.3040 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_0">
        <pose>-74.3040 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_1">
        <pose>-49.5360 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_1">
        <pose>-49.5360 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_2">
        <pose>-24.7680 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_2">
        <pose>-24.7680 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_3">
        <pose>0.0000 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_3">
        <pose>0.0000 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_4">
        <pose>24.7680 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_4">
        <pose>24.7680 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_5">
        <pose>49.5360 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
