        <pose>49.5360 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="pillar_6">
        <pose>74.3040 0 1.9250 0 0 0</pose>
        <geometry><box><size>1.0000 1.6000 3.8500</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="cap_6">
        <pose>74.3040 0 3.7800 0 0 0</pose>
        <geometry><box><size>1.4000 2.4000 0.2400</size></box></geometry>
        <material><diffuse>0.60 0.60 0.58 1</diffuse></material>
      </visual>
      <visual name="beam">
        <pose>0 0 4.4500 0 0 0</pose>
        <geometry><box><size>136.2240 2.2000 1.1000</size></box></geometry>
        <material><diffuse>0.78 0.78 0.76 1</diffuse></material>
      </visual>
      <visual name="flange_l">
        <pose>0 1.4500 3.9500 0 0 0</pose>
        <geometry><box><size>136.2240 0.8000 0.1000</size></box></geometry>
        <material><diffuse>0.45 0.46 0.50 1</diffuse></material>
      </visual>
      <visual name="stator_l">
        <pose>0 1.4500 3.8600 0 0 0</pose>
        <geometry><box><size>136.2240 0.7000 0.0800</size></box></geometry>
        <material><diffuse>0.25 0.30 0.55 1</diffuse></material>
      </visual>
      <visual name="flange_r">
        <pose>0 -1.4500 3.9500 0 0 0</pose>
        <geometry><box><size>136.2240 0.8000 0.1000</size></box></geometry>
        <material><diffuse>0.45 0.46 0.50 1</diffuse></material>
      </visual>
      <visual name="stator_r">
        <pose>0 -1.4500 3.8600 0 0 0</pose>
        <geometry><box><size>136.2240 0.7000 0.0800</size></box></geometry>
        <material><diffuse>0.25 0.30 0.55 1</diffuse></material>
      </visual>
    </link>
    <link name="lift">
      <pose>0 0 6.0 0 0 0</pose>
    </link>
    <link name="car">
      <pose>0 0 6.0 0 0 0</pose>
      <visual name="cabin">
        <pose>0 0 0.3250 0 0 0</pose>
        <geometry><box><size>21.0000 3.7000 2.5500</size></box></geometry>
        <material><diffuse>0.92 0.93 0.95 1</diffuse></material>
      </visual>
      <visual name="nose_f">
        <pose>10.5000 0 -0.0250 0 0 0</pose>
        <geometry><box><size>6.0000 3.5000 1.8500</size></box></geometry>
        <material><diffuse>0.92 0.93 0.95 1</diffuse></material>
      </visual>
      <visual name="nose_top_f">
        <pose>9.9000 0 1.2750 0 -0.2500 0</pose>
        <geometry><box><size>5.2000 3.3000 0.2500</size></box></geometry>
        <material><diffuse>0.88 0.90 0.93 1</diffuse></material>
      </visual>
      <visual name="glass_f">
        <pose>11.9000 0 0.8750 0 -0.5000 0</pose>
        <geometry><box><size>0.1500 2.8000 0.9000</size></box></geometry>
