<?xml version="1.0"?>
<!--
  maglev-module: one levitation module (Z up, metres, side view). The magnet pad hangs below the rail;
  the joint "gap" carries the gap with a gain of 20 (deviations from the nominal 10 mm exaggerated 20 times),
  the joint "suspension" carries the stretch of the secondary spring, also exaggerated. The coil is
  coloured by the current.
  Written by examples/maglev-train/design/build_model.py.
-->
<sdf version="1.9">
  <model name="maglev-module">
    <link name="rig">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>6.0000 3.0000 0.1000</size></box></geometry>
        <material><diffuse>0.28 0.40 0.24 1</diffuse></material>
      </visual>
      <visual name="pillar_1">
        <pose>1.4000 0 1.0 0 0 0</pose>
        <geometry><box><size>0.4000 0.8000 2.0000</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="pillar_-1">
        <pose>-1.4000 0 1.0 0 0 0</pose>
        <geometry><box><size>0.4000 0.8000 2.0000</size></box></geometry>
        <material><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>
      <visual name="beam">
        <pose>0 0 2.3 0 0 0</pose>
        <geometry><box><size>3.6000 1.0000 0.6000</size></box></geometry>
        <material><diffuse>0.78 0.78 0.76 1</diffuse></material>
      </visual>
      <visual name="rail">
        <pose>0 0 1.97 0 0 0</pose>
        <geometry><box><size>3.0000 1.2000 0.0600</size></box></geometry>
        <material><diffuse>0.25 0.30 0.55 1</diffuse></material>
      </visual>
      <visual name="skid_1">
        <pose>0.9000 0 1.7900 0 0 0</pose>
        <geometry><box><size>0.2500 0.9000 0.0400</size></box></geometry>
        <material><diffuse>0.85 0.6 0.15 1</diffuse></material>
      </visual>
      <visual name="skid_-1">
        <pose>-0.9000 0 1.7900 0 0 0</pose>
        <geometry><box><size>0.2500 0.9000 0.0400</size></box></geometry>
        <material><diffuse>0.85 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="bogie">
      <pose>0 0 1.94 0 0 0</pose>
      <visual name="pad">
        <pose>0 0 -0.08 0 0 0</pose>
        <geometry><box><size>1.3000 0.8000 0.1600</size></box></geometry>
        <material><diffuse>0.35 0.36 0.40 1</diffuse></material>
      </visual>
      <visual name="coil">
        <pose>0 0 -0.2 0 0 0</pose>
        <geometry><box><size>1.1000 0.9000 0.1200</size></box></geometry>
        <material><diffuse>0.78 0.45 0.20 1</diffuse></material>
      </visual>
      <visual name="frame">
        <pose>0 0 -0.34 0 0 0</pose>
        <geometry><box><size>1.5000 0.6000 0.2000</size></box></geometry>
        <material><diffuse>0.50 0.54 0.60 1</diffuse></material>
      </visual>
      <visual name="spring">
        <pose>0.45 0 -0.62 0 0 0</pose>
        <geometry><cylinder><radius>0.0500</radius><length>0.4000</length></cylinder></geometry>
        <material><diffuse>0.85 0.85 0.2 1</diffuse></material>
      </visual>
      <visual name="damper">
        <pose>-0.45 0 -0.62 0 0 0</pose>
        <geometry><cylinder><radius>0.0400</radius><length>0.4000</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
    <link name="body">
      <pose>0 0 1.94 0 0 0</pose>
      <visual name="body">
        <pose>0 0 -1.12 0 0 0</pose>
        <geometry><box><size>1.6000 1.0000 0.6000</size></box></geometry>
        <material><diffuse>0.92 0.93 0.95 1</diffuse></material>
      </visual>
      <visual name="window">
        <pose>0 0.51 -1.07 0 0 0</pose>
        <geometry><box><size>1.2000 0.0200 0.2500</size></box></geometry>
        <material><diffuse>0.12 0.17 0.28 1</diffuse></material>
      </visual>
    </link>
    <joint name="gap" type="prismatic">
      <parent>rig</parent>
      <child>bogie</child>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
    <joint name="suspension" type="prismatic">
      <parent>bogie</parent>
      <child>body</child>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
  </model>
</sdf>
