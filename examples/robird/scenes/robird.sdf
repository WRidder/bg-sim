    <joint name="flap_L" type="continuous">
      <parent>fuselage</parent>
      <child>hub_L</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="torsion_L" type="continuous">
      <parent>hub_L</parent>
      <child>wing_in_L</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <joint name="bend_L" type="continuous">
      <parent>wing_in_L</parent>
      <child>hub2_L</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="torsion2_L" type="continuous">
      <parent>hub2_L</parent>
      <child>wing_out_L</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <joint name="flap_R" type="continuous">
      <parent>fuselage</parent>
      <child>hub_R</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="torsion_R" type="continuous">
