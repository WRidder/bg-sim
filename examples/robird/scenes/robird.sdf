      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <joint name="elevon_L" type="continuous">
      <parent>fuselage</parent>
      <child>elevon_L_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="elevon_R" type="continuous">
      <parent>fuselage</parent>
      <child>elevon_R_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="rudder" type="continuous">
      <parent>fuselage</parent>
      <child>rudder_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
