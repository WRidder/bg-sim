<?xml version="1.0"?>
<!--
  lm-ascent: the ascent stage leaves the descent stage. Generated by design/build_model.py.
  Z-up, metres. The view keeps the ascent stage at the origin and moves the world (block LMView):
  "lm" is the ascent stage (link x = thrust axis, origin at its centre of mass, 4.3 m above the
  surface at lift-off); "site" carries the descent stage left at Tranquility Base and the craters;
  "ground" is the surface patch below the vehicle. The plume stretches with the thrust.
-->
