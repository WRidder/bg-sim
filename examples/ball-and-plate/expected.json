{
  "project": "ball-and-plate",
  "description": "Ball-and-plate rig (Quanser 2 DOF Ball Balancer type): a 1 in steel ball on a 0.35 m acrylic plate on a gimbal, tilted by two SRV02-type servos through cranks and push rods, an overhead camera at 30 frames/s with one frame of latency. Open-loop checks against the rolling-sphere laws (5/7 g sin a, 3/5 for a hollow ball, the rotation-rate drift of a swinging plate, energy); closed-loop checks of the cascaded PID and the LQR + Kalman controllers against the sampled linear loops of design/design.py.",
  "models": {
    "ball-and-plate-free": {
      "checks": [
        {
          "kind": "zero_crossing",
          "signal": "Contact/u1",
          "n": 1,
          "direction": "up",
          "value": 1.5662550428538595,
          "abs": 0.001,
          "note": "roll time to the centre, sqrt(2 x0 / a) with a = 5/7 g sin(1 deg) = 0.122292 m/s^2"
        },
        {
          "kind": "cursor_value",
          "signal": "Contact/u1",
          "t": 2.0,
          "value": 0.0945830102139304,
          "abs": 0.0002,
          "note": "x0 + a t^2 / 2 at 2 s (the lock springs let the tilt grow by 1.6e-5 rad as the ball moves)"
        },
        {
          "kind": "ratio",
          "signal": "Energy/Ekrot",
          "signal_b": "Energy/Ek",
          "t": 2.0,
          "value": 0.2857142857142857,
          "rtol": 0.002,
          "note": "rolling solid sphere: (J w^2) / (m v^2 + J w^2) = (2/5) / (7/5)"
        },
        {
          "kind": "max_abs_le",
          "signal": "Contact/slip",
          "from_t": 0.05,
          "value": 2e-05,
          "note": "no-slip residual: the regularised Coulomb friction creeps at (2/7) m g sin(a) vs / (mu f_n) = 1.25e-5 m/s"
        },
        {
          "kind": "invariant",
          "terms": [
            {
              "signal": "Energy/Ebal",
              "coeff": 1.0
            }
          ],
          "from_t": 0.1,
          "scale": 0.0028,
          "tol": 1e-05,
          "note": "E + contact loss is constant (lossless rig, crr = 0): drift below 1e-5 of the final kinetic energy 2.8e-3 J (the first 0.1 s settle the contact and joint deflections)"
        },
        {
          "kind": "scene_bindings"
        },
        {
          "kind": "no_diagnostics",
          "codes": [
            "E101",
            "E102",
            "E103",
            "E106",
