  "dashboard": {
    "autoRerun": true,
    "cards": [
      {
        "id": "d1",
        "kind": "text",
        "size": "2x2",
        "title": "Bridge crossing",
        "options": {
          "markdown": true,
          "text": "A lorry crosses the 30 m Warren truss. At full **strength** every member stays below 40 % of its capacity under the 20 t lorry. Scale the strength of all members down, or make the lorry heavier, until a member fails: the truss is statically determinate, so one failed bar is enough to bring it down. The end diagonal (bar 12) buckles first. Every change runs the model again."
        }
      },
      {
        "id": "d2",
        "kind": "slider",
        "size": "2x1",
        "title": "Member strength (all bars)",
        "parameter": "global:strength",
        "options": {
          "min": 0.2,
          "max": 1.5,
          "step": 0.05,
          "decimals": 2,
          "unit": "x"
        }
      },
      {
        "id": "d3",
        "kind": "slider",
        "size": "2x1",
        "title": "Lorry mass",
        "parameter": "global:m_truck",
        "options": {
