{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgsim.local/schemas/docs.schema.json",
  "title": "Docs",
  "description": "The documentation wiki of one model: a tree of Markdown pages stored in <project>/models/<model>.docs/ (docs.json, pages/<id>.md, assets/<hash>.<ext>). Page ids are stable slugs; renaming a title never renames the file.",
  "type": "object",
  "required": ["format", "version", "pages"],
  "properties": {
    "format": { "const": "bgsim.docs" },
    "version": { "const": 1 },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "$comment": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "page": {
      "title": "DocsPage",
      "description": "One wiki page: a stable id, a display title, the page file (always pages/<id>.md) and the child pages in order.",
      "type": "object",
      "required": ["id", "title", "file", "children"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "file": {
          "type": "string",
          "pattern": "^pages/[a-z0-9][a-z0-9-]{0,63}[.]md$"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/page" }
        }
      },
      "additionalProperties": false
    }
  }
}
