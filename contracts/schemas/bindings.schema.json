{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgsim.local/schemas/bindings.schema.json",
  "title": "Bindings",
  "description": "Viewer bindings (spec: \"Visualization and bindings\"). Bindings are stored with the model and reference scene names and signal ids only, never solver internals.",
  "type": "object",
  "required": ["bindings"],
  "properties": {
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "$comment": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "title": "Binding",
      "description": "One binding: a scene target, a property, the signal(s) that drive it, and optional gain and offset.",
      "anyOf": [
        { "$ref": "#/$defs/jointPositionBinding" },
        { "$ref": "#/$defs/poseBinding" },
        { "$ref": "#/$defs/visualScaleBinding" },
        { "$ref": "#/$defs/visualColorBinding" },
        { "$ref": "#/$defs/visibleBinding" }
      ]
    },
    "jointPositionBinding": {
      "title": "JointPositionBinding",
      "type": "object",
      "required": ["target", "property", "signal"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^joint:[A-Za-z0-9_.-]+$"
        },
        "property": { "const": "position" },
        "signal": { "$ref": "#/$defs/signalRef" },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "poseBinding": {
      "title": "PoseBinding",
      "type": "object",
      "required": ["target", "property", "signal"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(link|frame):[A-Za-z0-9_.-]+$"
        },
        "property": { "const": "pose" },
        "signal": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/signalRef" },
          "description": "Exactly 7 signals, in this fixed order: quaternion then position, (q_w, q_x, q_y, q_z, x, y, z), the same chart as the model's spatial pose Vec{7} (PoseIntegrator3D, ComposePose3D, JointTransform3D). The scalar quaternion part q_w comes first and the position is in metres in the world frame. The count is checked by the viewer (E304); the viewer must not reorder or infer the order from signal names."
        },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "visualScaleBinding": {
      "title": "VisualScaleBinding",
      "type": "object",
      "required": ["target", "property", "signal"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^visual:[A-Za-z0-9_.-]+$"
        },
        "property": { "title": "ScaleProperty", "enum": ["scale.x", "scale.y", "scale.z"] },
        "signal": { "$ref": "#/$defs/signalRef" },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "visualColorBinding": {
      "title": "VisualColorBinding",
      "type": "object",
      "required": ["target", "property", "signal", "colormap", "range"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^visual:[A-Za-z0-9_.-]+$"
        },
        "property": { "const": "color" },
        "signal": { "$ref": "#/$defs/signalRef" },
        "colormap": { "title": "Colormap", "enum": ["heat", "viridis", "coolwarm"] },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "visibleBinding": {
      "title": "VisibleBinding",
      "type": "object",
      "required": ["target", "property", "signal"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(visual|link):[A-Za-z0-9_.-]+$"
        },
        "property": { "const": "visible" },
        "signal": { "$ref": "#/$defs/signalRef" },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signalRef": {
      "title": "BindingSignal",
      "type": "string",
      "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*/)+[A-Za-z_][A-Za-z0-9_]*(?:\\[\\d+(?:,\\d+)?\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*)?$"
    }
  }
}
