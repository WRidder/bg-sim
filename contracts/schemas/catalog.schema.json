{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgsim.local/schemas/catalog.schema.json",
  "title": "Catalog",
  "description": "The library catalog (plan 3.2), produced by the worker and consumed by the editor: the available blocks with their full interface, the junction types and the power domains.",
  "type": "object",
  "required": ["language", "blocks", "junctions", "domains"],
  "properties": {
    "language": {
      "type": "string",
      "description": "Language version stamp, written into every saved model and block."
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalogBlock" }
    },
    "junctions": {
      "type": "array",
      "items": { "$ref": "#/$defs/junction" }
    },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain" }
    },
    "$comment": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "catalogBlock": {
      "title": "CatalogBlock",
      "description": "One library block: metadata, the interface of its declarations and its full source text.",
      "type": "object",
      "required": [
        "ref",
        "name",
        "group",
        "release",
        "description",
        "icon",
        "constants",
        "parameters",
        "inputs",
        "outputs",
        "ports",
        "variables",
        "causality",
        "source",
        "path"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(stdlib:[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*|project:[A-Za-z_][A-Za-z0-9_]*|inline:[A-Za-z0-9_.-]+)$",
          "description": "Block reference, plan 3.1."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "group": {
          "type": "string",
          "description": "Human-readable group, e.g. \"Bond graph\"."
        },
        "release": {
          "type": "string",
          "description": "Library release this block ships in, e.g. \"0.1\"."
        },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/constantDecl" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterDecl" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioDecl" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioDecl" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDecl" }
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/variableDecl" }
        },
        "causality": {
          "type": "array",
          "items": { "$ref": "#/$defs/causalityDecl" }
        },
        "source": {
          "type": "string",
          "description": "Full @block source text, for \"open source\" and \"copy to project\"."
        },
        "path": {
          "type": "string",
          "description": "Source path relative to the repository root, e.g. stdlib/bondgraph/C.jl."
        },
        "dimension": {
          "title": "ModelDimension",
          "enum": [2, 3],
          "description": "Model dimension of this block: 2 for a planar multibond block, 3 for a spatial one. Omitted for scalar/1D blocks, whose dimension is not encoded (D-MB12)."
        }
      },
      "additionalProperties": false
    },
    "blockInterface": {
      "title": "BlockInterface",
      "description": "The declarations of a block, without its metadata. Returned by block.check so the editor can refresh ports, inputs and parameters while the user types.",
      "type": "object",
      "required": [
        "constants",
        "parameters",
        "inputs",
        "outputs",
        "ports",
        "variables",
        "causality"
      ],
      "properties": {
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/constantDecl" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterDecl" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioDecl" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioDecl" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDecl" }
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/variableDecl" }
        },
        "causality": {
          "type": "array",
          "items": { "$ref": "#/$defs/causalityDecl" }
        },
        "dimension": {
          "title": "ModelDimension",
          "enum": [2, 3],
          "description": "Model dimension of this block: 2 for a planar multibond block, 3 for a spatial one. Omitted for scalar/1D blocks, whose dimension is not encoded (D-MB12)."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "constantDecl": {
      "title": "ConstantDecl",
      "type": "object",
      "required": ["name", "type", "default", "structural"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": { "title": "ValueType", "enum": ["Real", "Int", "Bool"] },
        "default": {
          "description": "Constant value: number, boolean, expression string or array (vector, matrix).",
          "oneOf": [
            { "type": "number" },
            { "type": "boolean" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "array", "items": { "type": "number" } }
                ]
              }
            }
          ]
        },
        "structural": {
          "type": "boolean",
          "description": "True when the constant sets an array size or otherwise changes the structure."
        }
      },
      "additionalProperties": false
    },
    "parameterDecl": {
      "title": "ParameterDecl",
      "type": "object",
      "required": [
        "name",
        "type",
        "default",
        "unit",
        "min",
        "max",
        "tunable",
        "description",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": { "title": "ValueType", "enum": ["Real", "Int", "Bool"] },
        "default": {
          "type": "string",
          "description": "Default value as a constant expression string, plan 5.2.4."
        },
        "unit": {
          "type": ["string", "null"],
          "description": "Unit string, or null when the parameter is dimensionless. Generic blocks may use the pseudo-dimensions effort and flow (D9)."
        },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "tunable": {
          "type": "boolean",
          "description": "True when the parameter stays adjustable at runtime."
        },
        "description": { "type": "string" },
        "options": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Allowed labels for an Int enumeration parameter (D11), or null."
        }
      },
      "additionalProperties": false
    },
    "ioDecl": {
      "title": "IoDecl",
      "type": "object",
      "required": ["name", "type", "size", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": { "title": "ValueType", "enum": ["Real", "Int", "Bool"] },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Array shape; empty for a scalar. Sizes are the default expansion of the block's structural constants."
        },
        "unit": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "portDecl": {
      "title": "PortDecl",
      "type": "object",
      "required": ["name", "domain", "size"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "domain": {
          "title": "DomainName",
          "enum": ["Electrical", "Translation", "Rotation", "Hydraulic", "Generic", "Planar", "Spatial"]
        },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "frame": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Reference frame in which this port's effort and flow (twist or wrench) are expressed (D-MB5). A bond or wire joining two different named frames is E007. Null or absent is frame-neutral: it unifies with any adjacent frame and never causes E007. A FixedTransform/JointTransform declares two frames and is the only legal bridge between them."
        }
      },
      "additionalProperties": false
    },
    "variableDecl": {
      "title": "VariableDecl",
      "type": "object",
      "required": ["name", "type", "size", "unit", "start", "state"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": { "title": "ValueType", "enum": ["Real", "Int", "Bool"] },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "unit": { "type": ["string", "null"] },
        "start": {
          "type": "string",
          "description": "Start value as a constant expression string."
        },
        "state": {
          "title": "VariableState",
          "type": ["string", "null"],
          "enum": ["prefer", "avoid", null],
          "description": "State-selection hint (spec: state = :prefer / :avoid), or null."
        }
      },
      "additionalProperties": false
    },
    "causalityDecl": {
      "title": "CausalityDecl",
      "type": "object",
      "required": ["ports", "kind", "value"],
      "properties": {
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "kind": {
          "title": "CausalityKind",
          "enum": ["preferred", "fixed", "transformer", "gyrator"],
          "description": "Causality kind, D6."
        },
        "value": {
          "title": "CausalityValue",
          "type": ["string", "null"],
          "enum": ["effort_out", "flow_out", null],
          "description": "effort_out or flow_out for preferred and fixed causality; null for transformer and gyrator."
        }
      },
      "additionalProperties": false
    },
    "junction": {
      "title": "CatalogJunction",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^junction:(0|1)$"
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "domain": {
      "title": "CatalogDomain",
      "description": "One power domain. The name partitions the shape: Planar and Spatial carry authoritative per-component unit arrays and size 3/6; the scalar domains carry size 1 and must not have a components array. For a multibond domain the scalar effort/flow descriptors are only the angular/first-component label kept for existing consumers.",
      "$comment": "The oneOf gives the code generators a concrete union to emit; the allOf/if/then below spells out the same name-based partition for validators and readers.",
      "oneOf": [
        { "$ref": "#/$defs/planarDomain" },
        { "$ref": "#/$defs/spatialDomain" },
        { "$ref": "#/$defs/scalarDomain" }
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "name": { "const": "Planar" } },
            "required": ["name"]
          },
          "then": {
            "type": "object",
            "required": ["components"],
            "properties": {
              "size": { "const": 3 },
              "components": { "$ref": "#/$defs/planarComponents" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "name": { "const": "Spatial" } },
            "required": ["name"]
          },
          "then": {
            "type": "object",
            "required": ["components"],
            "properties": {
              "size": { "const": 6 },
              "components": { "$ref": "#/$defs/spatialComponents" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "name": {
                "enum": ["Electrical", "Translation", "Rotation", "Hydraulic", "Generic"]
              }
            },
            "required": ["name"]
          },
          "then": {
            "type": "object",
            "not": { "type": "object", "required": ["components"] },
            "properties": { "size": { "const": 1 } }
          }
        }
      ]
    },
    "planarDomain": {
      "title": "PlanarDomain",
      "description": "The Planar multibond domain (D = 3): effort is a wrench [torque; force], flow a twist [angular velocity; linear velocity], and both are across = f (D8). components is required and authoritative for the per-component units.",
      "type": "object",
      "required": ["name", "effort", "flow", "across", "size", "components"],
      "properties": {
        "name": { "const": "Planar" },
        "effort": { "$ref": "#/$defs/domainVariable" },
        "flow": { "$ref": "#/$defs/domainVariable" },
        "across": { "const": "f" },
        "size": { "const": 3 },
        "components": { "$ref": "#/$defs/planarComponents" }
      },
      "additionalProperties": false
    },
    "spatialDomain": {
      "title": "SpatialDomain",
      "description": "The Spatial multibond domain (D = 6): effort is a wrench [torque; force], flow a twist [angular velocity; linear velocity], and both are across = f (D8). components is required and authoritative for the per-component units.",
      "type": "object",
      "required": ["name", "effort", "flow", "across", "size", "components"],
      "properties": {
        "name": { "const": "Spatial" },
        "effort": { "$ref": "#/$defs/domainVariable" },
        "flow": { "$ref": "#/$defs/domainVariable" },
        "across": { "const": "f" },
        "size": { "const": 6 },
        "components": { "$ref": "#/$defs/spatialComponents" }
      },
      "additionalProperties": false
    },
    "scalarDomain": {
      "title": "ScalarDomain",
      "description": "A scalar domain: size 1 and a single effort/flow unit pair. components is not allowed; the scalar descriptors are the whole unit story.",
      "type": "object",
      "required": ["name", "effort", "flow", "across", "size"],
      "properties": {
        "name": {
          "title": "DomainName",
          "enum": ["Electrical", "Translation", "Rotation", "Hydraulic", "Generic"]
        },
        "effort": { "$ref": "#/$defs/domainVariable" },
        "flow": { "$ref": "#/$defs/domainVariable" },
        "across": {
          "title": "AcrossField",
          "type": ["string", "null"],
          "enum": ["e", "f", null],
          "description": "Which port field is the across variable (D8): e for Electrical and Hydraulic, f for Translation and Rotation; null for Generic until a domain is adopted."
        },
        "size": { "const": 1 }
      },
      "additionalProperties": false
    },
    "planarComponents": {
      "title": "PlanarComponents",
      "description": "The authoritative per-component units of a Planar port, angular component first (D-MB2). The scalar effort/flow descriptors on the domain are only the angular/first-component label kept for existing consumers.",
      "type": "object",
      "required": ["effort", "flow"],
      "properties": {
        "effort": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "description": "Effort unit per component, exactly 3: torque first, then the two force components. The spec value is [\"N*m\",\"N\",\"N\"]."
        },
        "flow": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "description": "Flow unit per component, exactly 3: angular velocity first, then the two linear velocities. The spec value is [\"rad/s\",\"m/s\",\"m/s\"]."
        }
      },
      "additionalProperties": false
    },
    "spatialComponents": {
      "title": "SpatialComponents",
      "description": "The authoritative per-component units of a Spatial port, angular component first (D-MB2). The scalar effort/flow descriptors on the domain are only the angular/first-component label kept for existing consumers.",
      "type": "object",
      "required": ["effort", "flow"],
      "properties": {
        "effort": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 },
          "description": "Effort unit per component, exactly 6: three torques, then three forces. The spec value is [\"N*m\",\"N*m\",\"N*m\",\"N\",\"N\",\"N\"]."
        },
        "flow": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 },
          "description": "Flow unit per component, exactly 6: three angular velocities, then three linear velocities. The spec value is [\"rad/s\",\"rad/s\",\"rad/s\",\"m/s\",\"m/s\",\"m/s\"]."
        }
      },
      "additionalProperties": false
    },
    "domainVariable": {
      "title": "DomainVariable",
      "description": "A scalar effort or flow label. On a multibond domain this is the angular/first component only; the per-component components.effort/components.flow arrays are authoritative.",
      "type": "object",
      "required": ["name", "unit"],
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
