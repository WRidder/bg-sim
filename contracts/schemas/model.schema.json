{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgsim.local/schemas/model.schema.json",
  "title": "Model",
  "description": "Model document (plan 3.3): what the editor saves as models/<name>.bgmodel.json. A subsystem nests the same diagram shape.",
  "type": "object",
  "required": ["format", "language", "name", "diagram", "settings"],
  "properties": {
    "format": { "const": "bgsim.model" },
    "language": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "diagram": { "$ref": "#/$defs/diagram" },
    "settings": { "$ref": "#/$defs/settings" },
    "plots": {
      "type": "array",
      "items": { "$ref": "#/$defs/plot" }
    },
    "scene": { "$ref": "#/$defs/scene" },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "https://bgsim.local/schemas/bindings.schema.json#/$defs/binding"
      }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/globalParameter" },
      "description": "Global (model-level) parameters, SolidWorks 'global variables' style: named constant expressions over literals, other globals and the whitelisted pure functions, statically evaluated at compile time and visible in every node's params, starts and constants at every diagram level. Names are unique (checked by the compiler, E003)."
    },
    "dashboard": { "$ref": "#/$defs/dashboard" },
    "$comment": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "diagram": {
      "title": "ModelDiagram",
      "description": "One diagram: the nodes, their connections and the annotations. A subsystem block nests the same shape.",
      "type": "object",
      "required": ["nodes", "connections"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/connection" }
        },
        "subsystemPorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/subsystemPort" },
          "description": "Exposed ports; only used inside a subsystem."
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/shape" },
          "description": "Background shapes, drawn behind the notes, wires and blocks. The array order is the z order: the first entry is the back-most."
        },
        "probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/probe" },
          "description": "Oscilloscope probes. Side-channel observers; the compiler ignores them."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probe": {
      "title": "ModelProbe",
      "type": "object",
      "required": ["id", "name", "kind", "position", "links"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": { "title": "ProbeKind", "enum": ["block", "window"] },
        "position": { "$ref": "#/$defs/point" },
        "panelPosition": { "$ref": "#/$defs/point" },
        "size": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 240 },
            "height": { "type": "number", "minimum": 140 },
            "$comment": { "type": "string" }
          },
          "additionalProperties": false
        },
        "open": { "type": "boolean" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/probeLink" }
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/probePanel" }
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probeLink": {
      "title": "ModelProbeLink",
      "type": "object",
      "required": ["id", "connection", "signals"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "connection": { "type": "string" },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probePanel": {
      "title": "ModelProbePanel",
      "type": "object",
      "required": ["id", "title", "signals"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "title": { "type": "string" },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "title": "ModelNode",
      "type": "object",
      "required": ["id", "name", "block", "position"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Stable editor id, never shown."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Instance name; the path segment of every signal id of this node."
        },
        "block": { "$ref": "#/$defs/block" },
        "position": { "$ref": "#/$defs/point" },
        "rotation": {
          "type": "number",
          "description": "Clockwise rotation of the glyph, in degrees."
        },
        "flipX": { "type": "boolean" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Parameter values as constant expression strings, keyed by parameter name."
        },
        "constants": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/constantValue" },
          "description": "Constant overrides, keyed by constant name."
        },
        "starts": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Start-value overrides as expression strings, keyed by variable name."
        },
        "ui": { "$ref": "#/$defs/nodeUi" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "block": {
      "title": "ModelBlock",
      "description": "Where a node's behaviour comes from: a library reference, a junction, an inline block or a nested subsystem.",
      "anyOf": [
        { "$ref": "#/$defs/blockRef" },
        { "$ref": "#/$defs/blockJunction" },
        { "$ref": "#/$defs/blockInline" },
        { "$ref": "#/$defs/blockSubsystem" }
      ]
    },
    "blockRef": {
      "title": "ModelBlockRef",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(stdlib:[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*|project:[A-Za-z_][A-Za-z0-9_]*|inline:[A-Za-z0-9_.-]+)$"
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockJunction": {
      "title": "ModelBlockJunction",
      "type": "object",
      "required": ["junction"],
      "properties": {
        "junction": { "title": "JunctionType", "enum": ["0", "1"] },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockInline": {
      "title": "ModelBlockInline",
      "type": "object",
      "required": ["inline"],
      "properties": {
        "inline": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string" },
            "$comment": { "type": "string" }
          },
          "additionalProperties": false
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockSubsystem": {
      "title": "ModelBlockSubsystem",
      "type": "object",
      "required": ["subsystem"],
      "properties": {
        "subsystem": {
          "type": "object",
          "required": ["ports", "diagram"],
          "properties": {
            "ports": {
              "type": "array",
              "items": { "$ref": "#/$defs/subsystemPort" }
            },
            "diagram": { "$ref": "#/$defs/diagram" },
            "$comment": { "type": "string" }
          },
          "additionalProperties": false
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "subsystemPort": {
      "title": "ModelSubsystemPort",
      "description": "A port exposed by a subsystem: the outside face plus the internal node and port it attaches to.",
      "anyOf": [
        { "$ref": "#/$defs/subsystemSignalPort" },
        { "$ref": "#/$defs/subsystemPowerPort" }
      ]
    },
    "subsystemSignalPort": {
      "title": "ModelSubsystemSignalPort",
      "type": "object",
      "required": [
        "name",
        "kind",
        "direction",
        "type",
        "size",
        "unit",
        "node",
        "port"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": { "const": "signal" },
        "direction": { "title": "SignalDirection", "enum": ["input", "output"] },
        "type": { "title": "ValueType", "enum": ["Real", "Int", "Bool"] },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "unit": { "type": ["string", "null"] },
        "node": { "type": "string" },
        "port": { "type": "string" },
        "ui": { "$ref": "#/$defs/subsystemPortUi" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "subsystemPowerPort": {
      "title": "ModelSubsystemPowerPort",
      "type": "object",
      "required": ["name", "kind", "domain", "size", "node", "port"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": { "const": "power" },
        "domain": {
          "title": "DomainName",
          "enum": ["Electrical", "Translation", "Rotation", "Hydraulic", "Thermal", "Generic", "Planar", "Spatial"]
        },
        "size": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "enum": [1, 3, 6] },
          "description": "Port shape; a power port has one axis: [1] for a scalar domain, [3] for Planar and [6] for Spatial. The allOf below pins it to the declared domain."
        },
        "frame": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Reference frame in which the exposed port's twist/wrench are expressed (D-MB5). This port's frame is authoritative for the exposed port; it may differ from the internal port's catalog frame only through an internal FixedTransform/JointTransform, which the flattener accepts. Null or absent is frame-neutral: it unifies with any adjacent frame and never causes E007. A bond or wire joining two different named frames is E007; E007 reports the bond with the reported port in `path` and the other end in `related`."
        },
        "effortUnits": {
          "oneOf": [
            { "$ref": "#/$defs/unitArray3" },
            { "$ref": "#/$defs/unitArray6" }
          ],
          "description": "Per-component effort units carried through the subsystem boundary, angular first. Must equal the catalog domain's components.effort for the port's domain; derivation from the domain is preferred, so these fields exist only when a subsystem overrides a Generic port. Exactly 3 for Planar, 6 for Spatial."
        },
        "flowUnits": {
          "oneOf": [
            { "$ref": "#/$defs/unitArray3" },
            { "$ref": "#/$defs/unitArray6" }
          ],
          "description": "Per-component flow units carried through the subsystem boundary, angular first. Must equal the catalog domain's components.flow for the port's domain; derivation from the domain is preferred, so these fields exist only when a subsystem overrides a Generic port. Exactly 3 for Planar, 6 for Spatial."
        },
        "node": { "type": "string" },
        "port": { "type": "string" },
        "ui": { "$ref": "#/$defs/subsystemPortUi" },
        "$comment": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "domain": { "const": "Planar" } },
            "required": ["domain"]
          },
          "then": {
            "type": "object",
            "properties": { "size": { "const": [3] } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "domain": { "const": "Spatial" } },
            "required": ["domain"]
          },
          "then": {
            "type": "object",
            "properties": { "size": { "const": [6] } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "domain": {
                "enum": ["Electrical", "Translation", "Rotation", "Hydraulic", "Thermal", "Generic"]
              }
            },
            "required": ["domain"]
          },
          "then": {
            "type": "object",
            "properties": { "size": { "const": [1] } }
          }
        }
      ],
      "additionalProperties": false
    },
    "subsystemPortUi": {
      "title": "ModelSubsystemPortUi",
      "description": "Editor-only presentation of an exposed port inside the subsystem: where its terminal sits on the nested diagram. The compiler ignores it; without it the editor places the terminal at the edge of the nested content.",
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": { "$ref": "#/$defs/point" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "connection": {
      "title": "ModelConnection",
      "type": "object",
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "kind": {
          "title": "ConnectionKind",
          "enum": ["bond", "wire", "signal"],
          "description": "Connection kind (D7): bond (half arrow at \"to\", power from -> to), wire (node of concrete-domain power ports) or signal (one output to many inputs)."
        },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "route": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" },
          "description": "Optional waypoints."
        },
        "label": { "type": ["string", "null"] },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "title": "ModelEndpoint",
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": {
          "type": "string",
          "description": "Node id."
        },
        "port": {
          "type": "string",
          "description": "Port, input or output name; omitted for junction nodes."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "point": {
      "title": "ModelPoint",
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "annotation": {
      "title": "ModelAnnotation",
      "description": "A sticky note on one diagram level: Markdown text in a coloured card behind the blocks. Editor-only; compile, simulation and export ignore it.",
      "type": "object",
      "required": ["id", "kind", "text", "x", "y", "w", "h"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "kind": { "title": "AnnotationKind", "enum": ["text"] },
        "text": { "type": "string", "description": "Markdown (no images, no tables; headings render as bold text)." },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "color": {
          "title": "AnnotationColor",
          "description": "The card colour; absent means yellow. The editor themes each colour for dark and light mode.",
          "enum": ["yellow", "blue", "green", "pink", "grey"]
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "shape": {
      "title": "ModelShape",
      "description": "A background shape on one diagram level (rectangle, rounded rectangle, ellipse, line or arrow), drawn behind notes, wires and blocks. `fill` absent means none (lines and arrows ignore it); `stroke` absent means ink. Editor-only; compile, simulation and export ignore it.",
      "type": "object",
      "required": ["id", "kind", "x", "y", "w", "h"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "kind": { "title": "ShapeKind", "enum": ["rectangle", "roundedRectangle", "ellipse", "line", "arrow"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "description": "Rectangle, rounded rectangle and ellipse: the frame width (positive). Line and arrow: the end point is (x + w, y + h), so w and h may be negative." },
        "h": { "type": "number" },
        "fill": { "$ref": "#/$defs/shapeColor" },
        "stroke": { "$ref": "#/$defs/shapeColor" },
        "strokeWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 24,
          "description": "Outline width in diagram units; absent means 2."
        },
        "strokeStyle": {
          "title": "ShapeStrokeStyle",
          "enum": ["solid", "dashed", "dotted"],
          "description": "Absent means solid."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The opacity of the whole shape, label included; absent means 1."
        },
        "text": { "type": "string", "description": "An optional plain-text label, placed by `labelPosition`." },
        "labelPosition": {
          "title": "ShapeLabelPosition",
          "enum": ["topLeft", "top", "topRight", "left", "center", "right", "bottomLeft", "bottom", "bottomRight"],
          "description": "Where the label sits inside the shape's box: a corner, the middle of an edge, or the centre; absent means center. A line or arrow always centres its label."
        },
        "locked": {
          "type": "boolean",
          "description": "A locked shape cannot be moved, resized or deleted on the canvas, and a selection rectangle skips it; absent means false."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "shapeColor": {
      "title": "ShapeColor",
      "description": "A shape colour: the sticky-note palette plus `ink` (the theme's text colour) and `none`. The editor themes each colour for dark and light mode.",
      "enum": ["none", "ink", "yellow", "blue", "green", "pink", "grey"]
    },
    "nodeUi": {
      "title": "ModelNodeUi",
      "type": "object",
      "required": ["showLabel"],
      "properties": {
        "showLabel": { "type": "boolean" },
        "color": { "type": ["string", "null"] },
        "image": { "$ref": "#/$defs/nodeImage" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nodeImage": {
      "title": "ModelNodeImage",
      "description": "An image drawn inside the node's card (the editor offers it on subsystem nodes). The editor compresses an image to fit 512 KiB decoded before it stores it; the schema limit is the base64 length of 512 KiB.",
      "type": "object",
      "required": ["mime", "data", "fit"],
      "properties": {
        "mime": {
          "title": "ModelNodeImageMime",
          "enum": ["image/png", "image/svg+xml", "image/webp", "image/jpeg"]
        },
        "data": {
          "type": "string",
          "minLength": 4,
          "maxLength": 699052,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "description": "The image file as standard base64 without line breaks: at most 699052 characters, which is 512 KiB decoded."
        },
        "fit": {
          "title": "ModelNodeImageFit",
          "enum": ["contain", "stretch"],
          "description": "contain keeps the aspect ratio inside the card body; stretch fills it."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "constantValue": {
      "title": "ModelConstantValue",
      "description": "A constant override: number, boolean, expression string or array (vector, matrix).",
      "oneOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "number" },
              { "type": "array", "items": { "type": "number" } }
            ]
          }
        }
      ]
    },
    "settings": {
      "title": "ModelSettings",
      "type": "object",
      "required": [
        "t_start",
        "t_end",
        "solver",
        "reltol",
        "abstol",
        "max_step",
        "output",
        "event_limit"
      ],
      "properties": {
        "t_start": { "type": "number" },
        "t_end": { "type": "number" },
        "solver": {
          "type": "string",
          "description": "\"auto\" or a solver name."
        },
        "reltol": { "type": "number", "exclusiveMinimum": 0 },
        "abstol": { "type": "number", "exclusiveMinimum": 0 },
        "max_step": { "type": ["number", "null"] },
        "output": { "$ref": "#/$defs/output" },
        "event_limit": { "type": "integer", "minimum": 0 },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "output": {
      "title": "ModelOutput",
      "description": "The recording grid: a fixed number of points over [t_start, t_end], or a fixed interval.",
      "oneOf": [
        {
          "title": "ModelOutputPoints",
          "type": "object",
          "required": ["mode", "points"],
          "properties": {
            "mode": { "const": "points" },
            "points": { "type": "integer", "minimum": 2 },
            "$comment": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "title": "ModelOutputInterval",
          "type": "object",
          "required": ["mode", "interval"],
          "properties": {
            "mode": { "const": "interval" },
            "interval": { "type": "number", "exclusiveMinimum": 0 },
            "$comment": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "plot": {
      "title": "ModelPlot",
      "type": "object",
      "required": ["id", "title", "signals"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*/)+[A-Za-z_][A-Za-z0-9_]*(?:\\[\\d+(?:,\\d+)?\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*(?:\\[\\d+(?:,\\d+)?\\])?)?$"
          }
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scene": {
      "title": "ModelScene",
      "type": ["object", "null"],
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Scene file relative to the project directory, e.g. scenes/drivetrain.sdf."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "unitArray3": {
      "title": "UnitArray3",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "description": "Three unit strings, one per component (Planar)."
    },
    "unitArray6": {
      "title": "UnitArray6",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 },
      "description": "Six unit strings, one per component (Spatial)."
    },
    "globalParameter": {
      "title": "ModelGlobalParameter",
      "description": "One global parameter. `value` is a constant expression string (`2.5`, `4*m`, `sqrt(k/m)`); `unit` and `description` document it and are not checked against the value.",
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "title": "ModelDashboard",
      "description": "The Dashboard tab (plan DASHBOARD_PLAN.md): an ordered grid of cards. Display cards show recorded run signals; input cards and schedule tables give parameter overrides that the editor sends with the next run (run.start parameterOverrides / parameterSchedule). The compiler and the export ignore it.",
      "type": "object",
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboardCard" },
          "description": "The cards in grid order."
        },
        "autoRerun": {
          "type": "boolean",
          "description": "Start a new run shortly after an input card or schedule change settles."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboardCard": {
      "title": "ModelDashboardCard",
      "type": "object",
      "required": ["id", "kind", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "kind": {
          "title": "DashboardCardKind",
          "enum": [
            "plot",
            "value",
            "gauge",
            "bar",
            "indicator",
            "text",
            "number",
            "slider",
            "knob",
            "toggle",
            "select",
            "schedule"
          ]
        },
        "size": {
          "title": "DashboardCardSize",
          "enum": ["1x1", "2x1", "1x2", "2x2", "4x2"],
          "description": "Columns x rows of the grid."
        },
        "title": { "type": "string" },
        "signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Display cards: the bound signal ids (a plot may have several, the other display cards use the first)."
        },
        "parameter": {
          "type": "string",
          "pattern": "^(?:global:[A-Za-z_][A-Za-z0-9_]*|(?:[A-Za-z_][A-Za-z0-9_]*/)+[A-Za-z_][A-Za-z0-9_]*)$",
          "description": "Input cards: the bound parameter, a block parameter <instance path>/<param> or a global parameter global:<name> (number, slider and knob cards)."
        },
        "value": {
          "oneOf": [{ "type": "number" }, { "type": "boolean" }],
          "description": "Input cards: the override value for the next run; absent means the model's own value is used."
        },
        "options": { "$ref": "#/$defs/dashboardCardOptions" },
        "schedule": { "$ref": "#/$defs/dashboardSchedule" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboardCardOptions": {
      "title": "ModelDashboardCardOptions",
      "description": "Per-card display and input settings; every field is optional.",
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 12 },
        "unit": {
          "type": "string",
          "description": "Unit label shown on the card instead of the signal's or parameter's unit; an empty string hides it."
        },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboardZone" }
        },
        "threshold": {
          "type": "number",
          "description": "Indicator: the value at which the light switches."
        },
        "onWhen": {
          "title": "DashboardIndicatorMode",
          "enum": ["above", "below"],
          "description": "Indicator: on when the value is above (default) or below the threshold."
        },
        "orientation": {
          "title": "DashboardBarOrientation",
          "enum": ["vertical", "horizontal"]
        },
        "sparkline": { "type": "boolean", "description": "Value card: draw the recent history under the number." },
        "text": { "type": "string", "description": "Text card: the text, plain or Markdown." },
        "markdown": { "type": "boolean" },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboardZone": {
      "title": "ModelDashboardZone",
      "type": "object",
      "required": ["from", "to", "tone"],
      "properties": {
        "from": { "type": "number" },
        "to": { "type": "number" },
        "tone": { "title": "DashboardZoneTone", "enum": ["good", "warn", "bad", "info"] },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboardSchedule": {
      "title": "ModelDashboardSchedule",
      "description": "Schedule table: from each row's t on, the listed parameters take the row's values (piecewise constant). Before the first row the model's values apply.",
      "type": "object",
      "required": ["parameters", "rows"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*/)+[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": "The parameter columns, <instance path>/<param>."
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboardScheduleRow" }
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboardScheduleRow": {
      "title": "ModelDashboardScheduleRow",
      "type": "object",
      "required": ["t", "values"],
      "properties": {
        "t": { "type": "number", "description": "Seconds." },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] },
          "description": "One value per parameter column; null is a cell not filled in yet (the editor refuses to run with one)."
        },
        "$comment": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
