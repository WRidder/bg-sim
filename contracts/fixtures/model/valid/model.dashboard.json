        "id": "c7",
        "kind": "slider",
        "size": "2x1",
        "parameter": "R1/R",
        "value": 12.5,
        "options": {
          "min": 1,
          "max": 50,
          "step": 0.5
        }
      },
      {
        "id": "c8",
        "kind": "knob",
        "size": "1x1",
        "parameter": "L1/L",
        "options": {
          "min": 0.001,
          "max": 0.1
        }
      },
      {
        "id": "c9",
        "kind": "number",
        "size": "1x1",
        "parameter": "V1/V",
        "value": 2
      },
      {
        "id": "c10",
        "kind": "schedule",
        "size": "2x2",
        "title": "Supply steps",
        "schedule": {
          "parameters": [
            "Step1/final"
          ],
          "rows": [
            {
              "t": 0,
              "values": [
                1
              ]
            },
            {
              "t": 0.01,
              "values": [
                0.5
              ]
            }
          ]
        }
