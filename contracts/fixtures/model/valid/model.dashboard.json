    "autoRerun": false,
    "cards": [
      {
        "id": "c1",
        "kind": "plot",
        "size": "4x2",
        "title": "Capacitor voltage",
        "signals": [
          "C1/v",
          "L1/i"
        ]
      },
      {
        "id": "c2",
        "kind": "value",
        "size": "1x1",
        "title": "v_C",
        "signals": [
