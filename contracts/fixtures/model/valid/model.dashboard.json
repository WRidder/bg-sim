        "options": {
          "decimals": 3,
          "sparkline": true
        }
      },
      {
        "id": "c3",
        "kind": "gauge",
        "size": "2x2",
        "signals": [
          "L1/i"
        ],
        "options": {
          "min": -0.1,
          "max": 0.1,
          "zones": [
