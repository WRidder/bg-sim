        "options": {
          "min": 0,
          "max": 1.5,
          "orientation": "vertical"
        }
      },
      {
        "id": "c5",
        "kind": "indicator",
        "size": "1x1",
        "title": "Overshoot",
        "signals": [
          "C1/v"
        ],
        "options": {
          "threshold": 1,
          "onWhen": "above"
        }
      },
      {
        "id": "c6",
        "kind": "text",
        "size": "2x1",
        "options": {
          "text": "Series **RLC** step response.",
          "markdown": true
