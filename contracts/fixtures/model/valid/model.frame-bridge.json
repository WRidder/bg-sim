        "ui": { "showLabel": true, "color": null }
      },
      {
        "id": "n3",
        "name": "Mount",
        "block": {
          "subsystem": {
            "ports": [
              {
                "name": "a",
                "kind": "power",
                "domain": "Planar",
                "size": [3],
                "frame": "world",
                "effortUnits": ["N*m", "N", "N"],
                "flowUnits": ["rad/s", "m/s", "m/s"],
                "node": "s1",
                "port": "a"
              },
              {
                "name": "b",
                "kind": "power",
                "domain": "Planar",
                "size": [3],
                "frame": "arm",
                "effortUnits": ["N*m", "N", "N"],
                "flowUnits": ["rad/s", "m/s", "m/s"],
                "node": "s1",
                "port": "b"
              }
            ],
            "diagram": {
              "nodes": [
                {
                  "id": "s1",
                  "name": "Transform",
                  "block": {
                    "inline": {
                      "source": "@block FixedTransform2D begin\n    @ports begin\n        a::Power{Planar}, [frame = \"world\"]\n        b::Power{Planar}, [frame = \"arm\"]\n    end\n    @parameters begin\n        x::Real = 0.4, [unit = \"m\"]\n        y::Real = 0.0, [unit = \"m\"]\n        theta::Real = 0.0, [unit = \"rad\"]\n    end\n    @equations begin\n        # g maps arm -> world; a.f = Ad(g) b.f and b.e = Ad(g)^T a.e (D-MB5).\n        a.f[1] ~ b.f[1]\n        a.f[2] ~ -y * b.f[1] + cos(theta) * b.f[2] - sin(theta) * b.f[3]\n        a.f[3] ~ x * b.f[1] + sin(theta) * b.f[2] + cos(theta) * b.f[3]\n        b.e[1] ~ a.e[1] - y * a.e[2] + x * a.e[3]\n        b.e[2] ~ cos(theta) * a.e[2] + sin(theta) * a.e[3]\n        b.e[3] ~ -sin(theta) * a.e[2] + cos(theta) * a.e[3]\n    end\nend"
                    }
                  },
                  "position": { "x": 0, "y": 0 },
                  "rotation": 0,
                  "flipX": false,
                  "params": { "x": "0.4", "y": "0.0", "theta": "0.0" },
                  "constants": {},
                  "starts": {},
                  "ui": { "showLabel": true, "color": null }
                }
              ],
              "connections": [],
              "subsystemPorts": [],
              "annotations": []
            }
          }
        },
        "position": { "x": 500, "y": 200 },
        "rotation": 0,
        "flipX": false,
        "params": {},
        "constants": {},
        "starts": {},
        "ui": { "showLabel": true, "color": null }
      },
      {
        "id": "n4",
        "name": "Arm",
        "block": {
          "subsystem": {
            "ports": [
              {
                "name": "p",
                "kind": "power",
                "domain": "Planar",
                "size": [3],
                "frame": "arm",
                "effortUnits": ["N*m", "N", "N"],
                "flowUnits": ["rad/s", "m/s", "m/s"],
                "node": "s2",
                "port": "p"
              }
            ],
            "diagram": {
              "nodes": [
                {
                  "id": "s2",
                  "name": "Body",
                  "block": {
                    "inline": {
                      "source": "@block BodyPlanar begin\n    @ports p::Power{Planar}, [frame = \"arm\"]\n    @parameters begin\n        m::Real = 1.2, [unit = \"kg\", min = 0]\n        J::Real = 0.04, [unit = \"kg*m^2\", min = 0]\n    end\n    @variables P::Vec{3} = [0.0, 0.0, 0.0], [state = :prefer]\n    @equations begin\n        p.f[1] ~ P[1] / J\n        p.f[2] ~ P[2] / m\n        p.f[3] ~ P[3] / m\n        for k in 1:3\n            ddt(P[k]) ~ p.e[k]\n        end\n    end\n    @causality p => :flow_out\nend"
                    }
                  },
                  "position": { "x": 0, "y": 0 },
                  "rotation": 0,
                  "flipX": false,
                  "params": { "m": "1.2", "J": "0.04" },
                  "constants": {},
                  "starts": {},
                  "ui": { "showLabel": true, "color": null }
                }
              ],
              "connections": [],
              "subsystemPorts": [],
              "annotations": []
            }
          }
        },
