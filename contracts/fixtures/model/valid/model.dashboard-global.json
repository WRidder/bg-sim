{
  "$comment": "A dashboard whose knob overrides the global parameter m for the next run (run.start parameterOverrides kind global; with m = 3, Int1/y = sqrt(3) + 0.5 + 12 t). DASHBOARD_PLAN.md.",
  "format": "bgsim.model",
  "language": "0.1.0",
  "name": "DashboardGlobal",
  "parameters": [
    {
      "name": "m",
      "value": "2",
      "unit": "kg",
      "description": "Base mass"
    },
    {
      "name": "rate",
      "value": "4*m",
      "unit": "1/s",
      "description": "Driven by m"
    },
    {
      "name": "x0",
      "value": "sqrt(m) + 0.5",
      "unit": null,
      "description": null
    }
  ],
  "diagram": {
    "nodes": [
      {
        "id": "n1",
        "name": "Source",
        "block": {
          "subsystem": {
            "ports": [
              {
                "name": "y",
                "kind": "signal",
                "direction": "output",
                "type": "Real",
                "size": [],
                "unit": null,
                "node": "s1",
                "port": "y"
              }
            ],
            "diagram": {
              "nodes": [
                {
                  "id": "s1",
                  "name": "Rate",
                  "block": {
                    "ref": "stdlib:sources/Constant"
                  },
                  "position": {
                    "x": 100,
                    "y": 100
                  },
                  "params": {
                    "value": "rate"
                  }
                }
              ],
              "connections": []
            }
          }
        },
        "position": {
          "x": 40,
          "y": 120
        }
      },
      {
        "id": "n2",
        "name": "Int1",
        "block": {
          "ref": "stdlib:continuous/Integrator"
        },
        "position": {
          "x": 240,
          "y": 120
        },
        "starts": {
          "x": "x0"
        }
      }
    ],
    "connections": [
      {
        "id": "c1",
        "kind": "signal",
        "from": {
          "node": "n1",
          "port": "y"
        },
        "to": {
          "node": "n2",
          "port": "u"
        }
      }
    ]
  },
  "settings": {
    "t_start": 0,
    "t_end": 1,
    "solver": "auto",
    "reltol": 1e-8,
    "abstol": 1e-10,
    "max_step": null,
    "output": {
      "mode": "points",
      "points": 11
    },
    "event_limit": 10000
  },
  "dashboard": {
    "cards": [
      {
        "id": "mass",
        "kind": "knob",
        "size": "1x1",
        "title": "Base mass",
        "parameter": "global:m",
        "value": 3,
        "options": {
          "min": 0.5,
          "max": 10,
          "step": 0.5
        }
      },
      {
        "id": "y",
        "kind": "value",
        "size": "1x1",
        "signals": [
          "Int1/y"
        ],
        "options": {
          "decimals": 3,
          "sparkline": true
        }
      }
    ]
  }
}
