<?xml version="1.0"?>
<!-- Flexible beams for deformation bindings: a 1 m box beam along the link x axis (end A at the
     link origin) and a 0.8 m cylinder rod beside it (the cylinder's own axis z turned onto x), on a
     base block; the ball is no beam (validation E301). -->
<sdf version="1.9">
  <model name="beams">
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="clamp">
        <pose>-0.04 0 0.3 0 0 0</pose>
        <geometry><box><size>0.08 0.3 0.6</size></box></geometry>
        <material><diffuse>0.35 0.38 0.42 1</diffuse></material>
      </visual>
      <visual name="ball">
        <pose>-0.04 0 0.68 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </visual>
    </link>
    <link name="beam">
      <pose>0 0 0.45 0 0 0</pose>
      <visual name="beam_box">
        <pose>0.5 0 0 0 0 0</pose>
        <geometry><box><size>1.0 0.08 0.04</size></box></geometry>
        <material><diffuse>0.85 0.62 0.25 1</diffuse></material>
      </visual>
      <visual name="rod">
        <pose>0.4 0 -0.3 0 1.5707963267948966 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.8</length></cylinder></geometry>
        <material><diffuse>0.3 0.55 0.85 1</diffuse></material>
      </visual>
    </link>
    <joint name="mount" type="fixed">
      <parent>base</parent>
      <child>beam</child>
    </joint>
  </model>
</sdf>
