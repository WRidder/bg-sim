<?xml version="1.0"?>
<sdf version="1.7">
  <model name="chain">
    <link name="base">
      <visual name="base_visual"><geometry><box><size>0.4 0.4 0.1</size></box></geometry></visual>
    </link>
    <link name="l1">
      <pose>0 0 1 0 0 0</pose>
      <visual name="l1_visual"><geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry></visual>
    </link>
    <link name="l2">
      <pose>1 0 1 0 0 0</pose>
      <visual name="l2_visual"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual>
    </link>
    <joint name="j1" type="revolute">
      <parent>base</parent>
      <child>l1</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="j2" type="revolute">
      <parent>l1</parent>
      <child>l2</child>
      <pose>0 0 0.5 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
  </model>
</sdf>
