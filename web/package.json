{
  "name": "bgsim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "bg-sim web application: Vite + React + TypeScript editor for bond graphs, block diagrams and equation models",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "render-models": "node scripts/render-models.mjs",
    "capture-thumbnails": "node scripts/capture-thumbnails.mjs",
    "test": "vitest run",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.12.0",
    "immer": "11.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.8",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
